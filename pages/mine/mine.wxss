/**mine.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f6fa;
}

/* ---------- 个人资料 ---------- */
.profile {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: linear-gradient(135deg, #0e9484 0%, #19b5a3 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(15, 156, 140, 0.22);
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background-color: rgba(255, 255, 255, 0.24);
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.profile-btn {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background-color: rgba(255, 255, 255, 0.24);
}

.profile-btn:active {
  opacity: 0.8;
}
