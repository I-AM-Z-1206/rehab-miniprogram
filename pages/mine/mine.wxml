<!--mine.wxml —— 我的
    改版原因：这一页是旧语言残留 —— 灰底(#f5f6fa) + 白卡片 + 阴影 + 绿色渐变头像卡。
    从首页切到这里，底色和容器语言会整个换一套，看起来像两个 app。
    现在和首页/游戏页一致：纯白底、1rpx 细线分区、不放卡片、不用渐变。-->
<navigation-bar title="我的" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="ui-scroll" scroll-y type="list">
  <view class="page">

    <!-- 身份：名字是这一页唯一需要一眼看见的东西 -->
    <view class="me">
      <view class="me-main">
        <text class="me-name">{{nickname}}</text>
        <text class="me-sub">{{levelText}}</text>
      </view>
      <view class="me-avatar" bindtap="onEditNickname" aria-role="button" aria-label="修改昵称">
        <image class="ico" style="width:52rpx;height:52rpx" src="/assets/icons/user-round-teal.png" mode="aspectFit" />
      </view>
    </view>

    <!-- ============ 设置 ============ -->
    <view class="sec">
      <text class="sec-title">设置</text>
    </view>

    <view class="row">
      <image class="row-ico" src="/assets/icons/volume-2-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">语音播报</text>
        <text class="row-desc">连接、佩戴等节点会念出来</text>
      </view>
      <switch checked="{{speechOn}}" bindchange="onSpeechChange" color="#0f9c8c" />
    </view>

    <view class="row" bindtap="onTestVoice" aria-role="button" aria-label="试听语音，先确认手机音量已打开">
      <image class="row-ico" src="/assets/icons/play-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">试听语音</text>
        <text class="row-desc">先确认手机音量是开着的</text>
      </view>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <view class="row" bindtap="onEditNickname" aria-role="button" aria-label="修改昵称，当前是 {{nickname}}">
      <image class="row-ico" src="/assets/icons/pencil-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">修改昵称</text>
      </view>
      <text class="row-value">{{nickname}}</text>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <!-- ============ 数据与隐私 ============ -->
    <!-- 原来这一页对数据去向只字不提，只在页尾写了一句「不会上传到任何地方」，
         而实际是登录授权后静默上报 —— 告知与行为相反。这里把开关、说明、
         删除入口都放在患者能点到的地方，而不是只写在一份文档里。 -->
    <view class="sec">
      <text class="sec-title">数据与隐私</text>
    </view>

    <view class="row">
      <image class="row-ico" src="/assets/icons/sliders-horizontal-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">上传训练数据</text>
        <text class="row-desc">{{consentOn ? '得分、时长、稳定率会同步到云端，治疗师能看到你的进展' : '现在只存在这台手机上，治疗师看不到你的训练情况'}}</text>
      </view>
      <switch checked="{{consentOn}}" bindchange="onConsentChange" color="#0f9c8c" />
    </view>

    <view class="row" bindtap="onWhatUploaded" aria-role="button" aria-label="查看会上传哪些数据">
      <image class="row-ico" src="/assets/icons/info-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">会上传哪些数据</text>
      </view>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <view class="row" bindtap="onClearLocal" aria-role="button" aria-label="清空本机训练记录，共 {{localCount}} 条">
      <image class="row-ico" src="/assets/icons/rotate-ccw-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">清空本机记录</text>
        <text class="row-desc">共 {{localCount}} 条，已上传到云端的记录不受影响</text>
      </view>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <view class="row" bindtap="onDeleteCloud" aria-role="button" aria-label="删除已上传到云端的训练记录">
      <image class="row-ico" src="/assets/icons/rotate-ccw-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">删除云端记录</text>
        <text class="row-desc">删除后治疗师看不到你的历史训练</text>
      </view>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <!-- ============ 关于 ============ -->
    <view class="sec">
      <text class="sec-title">关于</text>
    </view>

    <view class="row" bindtap="onGuide" aria-role="button" aria-label="使用说明">
      <image class="row-ico" src="/assets/icons/book-open-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">使用说明</text>
      </view>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <view class="row" bindtap="onAbout" aria-role="button" aria-label="关于本程序，版本 {{version}}">
      <image class="row-ico" src="/assets/icons/info-teal.png" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">关于本程序</text>
      </view>
      <text class="row-value">{{version}}</text>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <text class="ui-tip">训练记录默认先保存到这台手机上。开启「上传训练数据」后才会同步到云端，用于治疗师查看进展和调整难度；可随时关闭并删除。</text>

  </view>
</scroll-view>
