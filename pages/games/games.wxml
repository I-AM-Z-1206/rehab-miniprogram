<!--games.wxml—— 游戏中心：按训练目标分组，选一个直接开始
     原来这里是「顶部横幅 + 两个带横线的分区标题 + 两张卡片列表」，
     和首页一样是卡片堆叠：五款游戏视觉权重完全相同，没有主次。
     现在改成纯列表 —— 玩家来这里只做一件事：挑一个开始。-->
<navigation-bar title="游戏" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="ui-scroll" scroll-y type="list">
  <view class="page">

    <view class="lead">
      <text class="lead-title">选一个开始</text>
      <text class="lead-desc">5 个游戏都用手上的传感器控制 · 身体动，画面才动</text>
    </view>

    <!-- 静态保持 -->
    <view class="group">
      <text class="group-title">静态保持</text>
      <text class="group-hint">站稳、控制住，身体别晃出范围</text>
    </view>
    <view
      wx:for="{{staticGames}}"
      wx:key="id"
      class="row"
      data-id="{{item.id}}"
      bindtap="onGameTap"
      aria-role="button"
      aria-label="{{item.title}}，{{item.desc}}，点击开始"
    >
      <image class="row-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-desc">{{item.desc}}</text>
      </view>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <!-- 动态控制 -->
    <view class="group group-gap">
      <text class="group-title">动态控制</text>
      <text class="group-hint">跟着目标移动身体，练重心转移</text>
    </view>
    <view
      wx:for="{{dynamicGames}}"
      wx:key="id"
      class="row"
      data-id="{{item.id}}"
      bindtap="onGameTap"
      aria-role="button"
      aria-label="{{item.title}}，{{item.desc}}，点击开始"
    >
      <image class="row-icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-desc">{{item.desc}}</text>
      </view>
      <image class="row-go" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
    </view>

    <text class="tip">训练前先在首页连接传感器并标定零点 —— 不标定，游戏里的判定会一直偏。</text>

  </view>
</scroll-view>
