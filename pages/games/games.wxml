<!--games.wxml—— 游戏中心：5 款体感游戏入口（静态保持 3 款 + 动态 2 款）-->
<navigation-bar title="游戏" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="ui-scroll" scroll-y type="list">
  <view class="ui-body">

    <!-- 顶部横幅 -->
    <view class="ui-banner game-banner">
      <view class="ui-banner-icon"><image class="ico ico-md" src="/assets/icons/gamepad-2-teal.png" mode="aspectFit" /></view>
      <view class="ui-banner-main">
        <view class="banner-count"><text class="banner-num">5</text> 款</view>
        <view class="ui-banner-desc">静态保持 3 款 + 动态 2 款 · 佩戴传感器用身体玩游戏</view>
      </view>
    </view>

    <!-- 静态保持训练 -->
    <view class="ui-sec">静态保持训练<view class="ui-sec-line"></view></view>
    <view class="ui-card">
      <view
        wx:for="{{staticGames}}"
        wx:key="id"
        class="ui-row {{index === staticGames.length - 1 ? 'ui-row-last' : ''}}"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="onGameTap"
      >
        <view class="ui-row-icon static"><image class="ico ico-sm" src="{{item.icon}}" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">{{item.title}}<text class="game-ready" wx:if="{{item.ready}}">可训练</text></view>
          <view class="ui-row-desc">{{item.desc}}</view>
        </view>
        <image class="ui-row-arrow-ico" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
      </view>
    </view>

    <!-- 动态训练 -->
    <view class="ui-sec">动态训练<view class="ui-sec-line"></view></view>
    <view class="ui-card">
      <view
        wx:for="{{dynamicGames}}"
        wx:key="id"
        class="ui-row {{index === dynamicGames.length - 1 ? 'ui-row-last' : ''}}"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="onGameTap"
      >
        <view class="ui-row-icon dynamic"><image class="ico ico-sm" src="{{item.icon}}" mode="aspectFit" /></view>
        <view class="ui-row-main">
          <view class="ui-row-title">{{item.title}}</view>
          <view class="ui-row-desc">{{item.desc}}</view>
        </view>
        <image class="ui-row-arrow-ico" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
      </view>
    </view>

    <view class="ui-tip">射击训练与走钢丝已上线：连接传感器后，用身体左右偏移控制角色，保持平衡完成训练。其余玩法开发中。</view>

  </view>
</scroll-view>
