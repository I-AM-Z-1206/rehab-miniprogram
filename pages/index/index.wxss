/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f6fa;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-body {
  padding: 24rpx;
}

/* ---------- 输入区 ---------- */
.input-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 16rpx 16rpx 16rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.todo-input {
  flex: 1;
  height: 72rpx;
  font-size: 30rpx;
  color: #333;
}

.add-btn {
  margin-left: 20rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 筛选栏 ---------- */
.filter-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 24rpx 8rpx;
}

.filter-item {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #fff;
}

.filter-item.active {
  background-color: #07c160;
  color: #fff;
  font-weight: 600;
}

.flex-spacer {
  flex: 1;
}

.clear-btn {
  font-size: 24rpx;
  color: #e64340;
  padding: 10rpx 8rpx;
}

/* ---------- 列表区 ---------- */
.todo-list {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.todo-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.todo-item:last-child {
  border-bottom: none;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #ccc;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #07c160;
  border-color: #07c160;
}

.checkbox-mark {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.todo-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  word-break: break-all;
}

.done-text {
  color: #bbb;
  text-decoration: line-through;
}

.delete-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #c8c9cc;
  flex-shrink: 0;
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

/* ---------- 底部统计 ---------- */
.footer {
  text-align: center;
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #999;
}

/* ---------- 功能入口 ---------- */
.entry-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 40rpx;
  padding: 28rpx 24rpx;
  background-color: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.entry-icon {
  font-size: 52rpx;
  margin-right: 24rpx;
}

.entry-text {
  flex: 1;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.entry-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.entry-arrow {
  font-size: 44rpx;
  color: #c8c9cc;
}
