/**index.wxss —— 首页
 *
 * 这一版重做的原因：原来是「绿色渐变横幅 + 四张同样大小的白卡片 + 灰底 + 阴影」，
 * 四块内容视觉权重完全一样，眼睛不知道先看哪，而「我的进步」还把主操作压在了下面。
 *
 * 现在的结构：
 *   1. 整页只有一个实心块（连接传感器），它是最重要且唯一需要按的东西；
 *   2. 其余全部是文字 + 1rpx 细线，不再用卡片容器 —— 卡片是偷懒的容器，
 *      四张同尺寸卡片并排就等于没有层级；
 *   3. 纯白底，不用灰底衬托卡片；
 *   4. 没有小标签（kicker）浮在标题上方，也没有卡片左侧的彩色竖条。
 *
 * 字号偏大、对比度偏高：使用者多为中老年患者，在家里用。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.page {
  padding: 20rpx 40rpx 180rpx;
}

/* ---------- 设备状态 ---------- */
.device {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 0 30rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #d3d7de;
  margin-right: 14rpx;
}

.dot.on {
  background-color: #0f9c8c;
}

.device-name {
  flex: 1;
  font-size: 24rpx;
  color: #8b9099;
  letter-spacing: 0.5rpx;
}

.device-state {
  font-size: 24rpx;
  color: #8b9099;
}

/* ---------- 主操作（整页唯一的实心块） ---------- */
.primary {
  padding: 40rpx 34rpx;
  border-radius: 24rpx;
  background-color: #0f9c8c;
  transition: transform 0.12s ease, background-color 0.2s ease;
}

.primary:active {
  transform: scale(0.985);
  background-color: #0d8b7d;
}

.primary-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

.primary-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}

/* ---------- 我的进步 ---------- */
.prog {
  margin-top: 10rpx;
  padding: 44rpx 4rpx 38rpx;
  border-bottom: 1rpx solid #eceff3;
  transition: opacity 0.12s ease;
}

.prog:active {
  opacity: 0.6;
}

.prog-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.prog-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #1a1f26;
  letter-spacing: -1rpx;
}

.prog-arrow {
  margin-left: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.prog-arrow.up { color: #0f9c8c; }
.prog-arrow.down { color: #c47b1f; }
.prog-arrow.flat { color: #a8aeb8; }

.prog-say {
  display: block;
  margin-top: 10rpx;
  font-size: 29rpx;
  line-height: 1.55;
  color: #4a515c;
}

.prog-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.prog-meta {
  font-size: 24rpx;
  color: #949aa3;
}

.prog-go {
  font-size: 25rpx;
  font-weight: 600;
  color: #0f9c8c;
}

/* ---------- 工具 ---------- */
.tool {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 38rpx 4rpx;
  border-bottom: 1rpx solid #eceff3;
  transition: opacity 0.12s ease;
}

.tool:active {
  opacity: 0.6;
}

.tool-main {
  flex: 1;
}

.tool-name {
  display: block;
  font-size: 30rpx;
  color: #1a1f26;
}

.tool-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #949aa3;
}

.tool-go {
  font-size: 34rpx;
  color: #c8ccd4;
  padding-left: 16rpx;
}

/* ---------- 说明 ---------- */
.tip {
  display: block;
  margin-top: 36rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: #a8aeb8;
}

/* ---------- 本周打卡（首页只给节奏感，细节在「我的进步」里） ---------- */
.week {
  display: flex;
  flex-direction: row;
  margin-top: 26rpx;
}

.wk {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 26rpx;
}

.wk-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background-color: #f2f4f7;
  border: 2rpx solid #e6eaf0;
  box-sizing: border-box;
}

.wk.on .wk-dot {
  background-color: #0f9c8c;
  border-color: #0f9c8c;
}

.wk.today .wk-dot {
  box-shadow: 0 0 0 5rpx rgba(15, 156, 140, 0.16);
}

.wk-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b3b9c2;
}

.wk.on .wk-label {
  color: #0f9c8c;
}
