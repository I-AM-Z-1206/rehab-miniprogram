/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f6fa;
}

/* ---------- 顶部横幅 ---------- */
.hero {
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #0e9484 0%, #19b5a3 100%);
  box-shadow: 0 12rpx 28rpx rgba(15, 156, 140, 0.22);
}

.hero-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.22);
}

.hero-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* ---------- 蓝牙连接（主位）/ 康复训练入口 ---------- */
.cta {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.16);
  border: 3rpx solid #d6f5e3;
}

.cta-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  text-align: center;
  line-height: 104rpx;
  font-size: 52rpx;
  background-color: #eafaf0;
}

.cta-main {
  flex: 1;
  margin-left: 24rpx;
}

.cta-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f9c8c;
}

.cta-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8b8f9a;
}

.cta-go {
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  background-color: #0f9c8c;
}

/* 蓝牙连接卡（青绿主题，连上后变绿） */
.cta.ble {
  border-color: #cfeae6;
  box-shadow: 0 8rpx 24rpx rgba(15, 156, 140, 0.14);
}

.cta.ble .cta-icon {
  background-color: #e9f7f4;
}

.cta.ble.linked {
  border-color: #07c160;
}

.cta.ble.linked .cta-icon {
  background-color: #eafaf0;
}

.cta.ble.linked .cta-title {
  color: #07c160;
}

.cta.ble.linked .cta-go {
  background-color: #07c160;
}

/* 连接状态条 */
.cta-state {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: -12rpx 0 24rpx;
}

.cta-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #c8ccd4;
  margin-right: 12rpx;
}

.cta-dot.on {
  background-color: #07c160;
}

.cta-state-text {
  font-size: 26rpx;
  color: #8b8f9a;
}
