/**index.wxss —— 首页
 *
 * 这一版重做的原因：原来是「绿色渐变横幅 + 四张同样大小的白卡片 + 灰底 + 阴影」，
 * 四块内容视觉权重完全一样，眼睛不知道先看哪，而「我的进步」还把主操作压在了下面。
 *
 * 现在的结构：
 *   1. 整页只有一个实心块（连接传感器），它是最重要且唯一需要按的东西；
 *   2. 其余全部是文字 + 1rpx 细线，不再用卡片容器 —— 卡片是偷懒的容器，
 *      四张同尺寸卡片并排就等于没有层级；
 *   3. 纯白底，不用灰底衬托卡片；
 *   4. 没有小标签（kicker）浮在标题上方，也没有卡片左侧的彩色竖条。
 *
 * 字号偏大、对比度偏高：使用者多为中老年患者，在家里用。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.page {
  padding: 20rpx 40rpx 180rpx;
}

/* ---------- 设备状态 ---------- */
.device {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 34rpx 0 30rpx;
}

.device:active {
  opacity: 0.55;
}

/* 12rpx 的点在灰底上几乎看不见，14rpx 才够当状态指示 */
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #ccd2da;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot.on {
  background-color: var(--teal);
}

/* 原来 24rpx（12px）+ #8b9099（3.4:1）：这是患者每次进门第一眼要确认的信息，
   不该是全页最弱的一行。26rpx + ink-3（6.0:1）。 */
.device-name {
  flex: 1;
  font-size: var(--fs-note);
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
}

.device-state {
  font-size: var(--fs-note);
  color: var(--ink-3);
}

.device-state.on {
  color: var(--teal-ink);
  font-weight: 600;
}

/* 右侧箭头：说明这一行可以点 */
.device-go {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 文字 + 箭头的最小组合，全页共用，避免再手打「›」字符 */
.link-go {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.go-ico {
  width: 32rpx;
  height: 32rpx;
  margin-left: 4rpx;
  flex-shrink: 0;
}

/* ---------- 主操作（整页唯一的实心块） ---------- */
.primary {
  padding: 40rpx 34rpx;
  border-radius: 24rpx;
  background-color: #0f9c8c;
  transition: transform 0.12s ease, background-color 0.2s ease;
}

.primary:active {
  transform: scale(0.985);
  background-color: #0d8b7d;
}

.primary-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

.primary-sub {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-body-s);
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.86);
}

/* ---------- 我的进步 ---------- */
.prog {
  margin-top: 0;
  padding: 32rpx 4rpx 38rpx;
  border-bottom: 1rpx solid var(--line);
  transition: opacity 0.12s ease;
}

.prog:active {
  opacity: 0.6;
}

.prog-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.prog-num {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--ink-1);
  letter-spacing: -1rpx;
}

/* 没有数据时这里显示的是句子不是数字（「还没有训练数据」「这周还没开始」），
   按 64rpx/700 渲染会变成一堵墙，还可能撞到右边缘。降到 40rpx/600。 */
.prog-num.is-text {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 0;
}

.prog-arrow {
  margin-left: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.prog-arrow.up { color: var(--teal-ink); }
.prog-arrow.down { color: var(--amber-ink); }
.prog-arrow.flat { color: var(--ink-4); }

.prog-say {
  display: block;
  margin-top: 10rpx;
  font-size: var(--fs-body);
  line-height: 1.55;
  color: var(--ink-2);
}

.prog-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.prog-meta {
  font-size: var(--fs-note);
  color: var(--ink-3);
}

.prog-go {
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--teal-ink);
}

/* ---------- 说明 ---------- */
/* 23rpx(11.5px) + #a8aeb8 只有 2.2:1，等于没写。26rpx + ink-3 是说明文字的下限。 */
.tip {
  display: block;
  margin-top: var(--gap-4);
  font-size: var(--fs-note);
  line-height: 1.75;
  color: var(--ink-3);
}

/* ---------- 本周打卡（首页只给节奏感，细节在「我的进步」里） ---------- */
.week {
  display: flex;
  flex-direction: row;
  margin-top: 26rpx;
}

.wk {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 26rpx;
}

.wk-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background-color: var(--line-soft);
  border: 2rpx solid var(--line);
  box-sizing: border-box;
}

.wk.on .wk-dot {
  background-color: var(--teal);
  border-color: var(--teal);
}

.wk.today .wk-dot {
  box-shadow: 0 0 0 5rpx rgba(15, 156, 140, 0.16);
}

.wk-label {
  margin-top: 8rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.wk.on .wk-label {
  color: var(--teal-ink);
  font-weight: 600;
}

/* ---------- 步骤号 ---------- */
.primary-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.primary-no {
  margin-right: 14rpx;
  font-size: var(--fs-note);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.72);
}

/* ---------- 未完成 / 已完成的步骤行 ----------
   层级反了要纠正：原来是「已完成」#8b9099、「待完成」#b3b9c2（2.0:1），
   也就是下一个该做的步骤比做完的还淡。已完成的才该退到后面。 */
.step {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.step-no {
  width: 44rpx;
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--ink-4);
}

.step-check {
  width: 44rpx;
  font-size: var(--fs-body-s);
  font-weight: 700;
  color: var(--teal-ink);
}

.step-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-name {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink-1);
}

.step.pending .step-name {
  color: var(--ink-2);
}

.step.done .step-name {
  color: var(--ink-3);
}

/* 13px 的说明文字不能落在 3.4:1 的灰上。弱化靠字号，不靠把对比度压到读不清。 */
.step-desc {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-note);
  color: var(--ink-3);
}

.step-go {
  font-size: var(--fs-note);
  color: var(--teal-ink);
  padding-left: 16rpx;
}

/* ---------- 就绪后的一行小字（重新标定入口） ---------- */
.ready {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.ready:active {
  opacity: 0.55;
}

.ready-text {
  font-size: var(--fs-note);
  color: var(--ink-3);
}

.ready-go {
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--teal-ink);
}
