<!--index.wxml—— 首页：蓝牙连接（主位）+ 功能入口-->
<navigation-bar title="首页" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="ui-scroll" scroll-y type="list">
  <view class="ui-body">

    <!-- 顶部横幅 -->
    <view class="hero">
      <view class="hero-tag-row">
        <view class="hero-tag">
          <image class="hero-tag-ico" src="/assets/icons/bluetooth-white.png" mode="aspectFit" />
          <text>WT9011DCL · 姿态传感</text>
        </view>
      </view>
      <view class="hero-title">运动康复助手</view>
      <view class="hero-desc">连一次蓝牙，全程不断开</view>
    </view>

    <!-- 蓝牙连接：主界面中间的主操作 -->
    <view class="cta ble {{bleLinked ? 'linked' : ''}}" bindtap="goWit">
      <view class="cta-icon"><image class="ico ico-lg" src="/assets/icons/bluetooth-teal.png" mode="aspectFit" /></view>
      <view class="cta-main">
        <view class="cta-title">连接蓝牙传感器</view>
        <view class="cta-desc">{{bleLinked ? '已连接 · 点击查看传感器数据' : '未连接 · 点击扫描并连接设备'}}</view>
      </view>
      <view class="cta-go">{{bleLinked ? '已连接' : '连接 ›'}}</view>
    </view>
    <view class="cta-state">
      <view class="cta-dot {{bleLinked ? 'on' : ''}}"></view>
      <view class="cta-state-text">{{bleLinked ? '蓝牙已连接' + (bleLinkedName ? ' · ' + bleLinkedName : '') : '蓝牙未连接'}}</view>
    </view>

    <!-- 零点标定入口 -->
    <view class="cta cal" bindtap="goCalibrate">
      <view class="cta-icon"><image class="ico ico-lg" src="/assets/icons/focus-blue.png" mode="aspectFit" /></view>
      <view class="cta-main">
        <view class="cta-title">零点标定</view>
        <view class="cta-desc">一键标定姿态虚拟零点（Roll / Pitch），并可查看加速度曲线</view>
      </view>
      <view class="cta-go">进入 ›</view>
    </view>

    <view class="ui-tip">
      用法：① 传感器开机（蓝灯快闪）→ ② 点上方「连接蓝牙传感器」→ ③ 把传感器绑在胸前即可查看姿态数据。连接成功后，不出小程序就不会自动断开。
    </view>

  </view>
</scroll-view>
