/**rehab.wxss—— 康复训练
 * 配色统一为「二色方案」：
 *   底色 = 深海蓝 #0b1220 / #16233c
 *   主色 = 青绿 #14b8a6（所有按钮、选中态、小人躯干）
 *   点色 = 琥珀 #ffc34d（金币、达标、警示）
 *   辅助 = 柔和靛蓝 #3b5b8f（腿部），仅作层次，不与主色抢
 **/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #0b1220;
}

.root {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  /* 康复是 tab 页：底部有自定义 tabBar（104rpx 高），必须留出空间，
     否则底部的「连接传感器」按钮会被 tabBar 完全盖住 */
  padding-bottom: 104rpx;
  padding-bottom: calc(104rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶部数据（大字号，适配脑卒中患者注意力） ---------- */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 72rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.1;
}

.stat-num.gold {
  color: #ffc34d;
}

.stat-sub {
  font-size: 42rpx;
  color: #93a0b8;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 34rpx;
  color: #aeb8cc;
}

/* ---------- 舞台（占约 70% 屏幕） ---------- */
.stage {
  flex: 1;
  position: relative;
  margin: 12rpx 0;
  background: linear-gradient(180deg, #16233c 0%, #101a2e 100%);
  overflow: hidden;
}

/* 提示条为浮层：不占布局高度，把空间留给小人；z-index 保证盖过小人
   字号控制在一行能放下，避免两行大字占掉半个屏幕 */
.tip-bar {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 16rpx;
  padding: 22rpx 28rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #ffffff;
  background-color: rgba(24, 35, 60, 0.94);
  z-index: 10;
}

.tip-bar.ok {
  background-color: #0d6350;
}

.tip-bar.warn {
  background-color: #7a5410;
}

.arrow {
  position: absolute;
  bottom: 60rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #5b6b8a;
  z-index: 5;
}

.arrow.left {
  left: 24rpx;
}

.arrow.right {
  right: 24rpx;
}

.arrow.active {
  color: #ffc34d;
  animation: blink 0.9s infinite;
}

@keyframes blink {
  0% { opacity: 1; }
  50% { opacity: 0.35; }
  100% { opacity: 1; }
}

.lean-badge {
  position: absolute;
  left: 24rpx;
  top: 190rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  z-index: 5;
}

.lean-num {
  font-size: 96rpx;
  font-weight: 800;
  color: #2fd8c3;
  line-height: 1;
}

.lean-label {
  margin-top: 8rpx;
  font-size: 34rpx;
  color: #aeb8cc;
}

/* ---------- 3D 小人 canvas（占满舞台） ---------- */
.man-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* ---------- 航空姿态仪（放大，飞机仪表盘更醒目） ---------- */
.hud {
  position: absolute;
  right: 24rpx;
  top: 190rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 10rpx solid #2a3856;
  background-color: #0a1120;
  box-shadow: 0 0 24rpx rgba(20, 184, 166, 0.25);
  z-index: 5;
}

.hud-horizon {
  position: absolute;
  left: -70%;
  top: -70%;
  width: 240%;
  height: 240%;
}

.hud-sky {
  height: 50%;
  background: linear-gradient(180deg, #1b4fa8 0%, #4b9dfa 100%);
}

.hud-line {
  height: 6rpx;
  background-color: #ffffff;
}

.hud-ground {
  height: calc(50% - 6rpx);
  background: linear-gradient(180deg, #1f6b5c 0%, #123f38 100%);
}

.hud-plane {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hud-bar {
  width: 190rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background-color: #ffc34d;
}

.hud-num {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 26rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ---------- 设置条 ---------- */
.panel {
  padding: 10rpx 24rpx;
}

.panel-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.panel-label {
  width: 168rpx;
  font-size: 34rpx;
  color: #aeb8cc;
}

.seg {
  flex: 1;
  display: flex;
  flex-direction: row;
  background-color: #18233c;
  border-radius: 16rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 36rpx;
  color: #93a0b8;
  border-radius: 12rpx;
}

.seg-item.on {
  background-color: #14b8a6;
  color: #ffffff;
  font-weight: 700;
}

.btn-flip {
  margin-left: 14rpx;
  padding: 0 22rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #ffc34d;
  border: 2rpx solid #ffc34d;
  border-radius: 16rpx;
}

.btn-cal {
  margin-left: 14rpx;
  padding: 0 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  background-color: #14b8a6;
  border-radius: 16rpx;
}

.btn-cal.off {
  opacity: 0.45;
}

/* ---------- 底部连接（居中，醒目大按钮） ---------- */
.dock {
  padding: 12rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dock-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  padding: 0 64rpx;
  border-radius: 60rpx;
  background-color: #18233c;
  border: 4rpx solid #2a3856;
}

.dock-btn.connected {
  background-color: #0d6350;
  border-color: #17a892;
}

.dock-btn.scanning {
  background-color: #6b5310;
  border-color: #c69212;
}

.dock-dot {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #93a0b8;
}

.dock-btn.connected .dock-dot {
  background-color: #46e0c8;
}

.dock-btn.scanning .dock-dot {
  background-color: #ffc34d;
  animation: blink 0.8s infinite;
}

.dock-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
}

.dock-sub {
  margin-top: 16rpx;
  font-size: 34rpx;
  color: #aeb8cc;
}

/* ---------- 金币飘字 ---------- */
.gain {
  position: absolute;
  right: 40rpx;
  top: 120rpx;
  font-size: 68rpx;
  font-weight: 800;
  color: #ffc34d;
  animation: gain-up 0.9s ease-out;
}

@keyframes gain-up {
  0% { opacity: 0; transform: translateY(20rpx); }
  30% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-60rpx); }
}

/* ---------- 设备浮层 ---------- */
.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.dev-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 62vh;
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx 40rpx;
  border-radius: 32rpx 32rpx 0 0;
  background-color: #18233c;
  /* 默认隐藏在屏幕外，仅 showDevices 时滑入（修复面板一直露在底部的问题） */
  transform: translateY(105%);
  transition: transform 0.25s ease-out;
  z-index: 30;
}

.dev-panel.show {
  transform: translateY(0);
}

.dev-list {
  flex: 1;
  max-height: 48vh;
}

.dev-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.dev-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #26324e;
}

.dev-info {
  flex: 1;
}

.dev-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
}

.dev-id {
  margin-top: 8rpx;
  font-size: 32rpx;
  color: #aeb8cc;
}

.dev-go {
  padding: 20rpx 48rpx;
  border-radius: 44rpx;
  background-color: #14b8a6;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
}

.dev-empty {
  padding: 36rpx 0;
  text-align: center;
  font-size: 36rpx;
  color: #aeb8cc;
}
