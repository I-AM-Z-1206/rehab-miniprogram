<!--rehab.wxml—— 康复训练：胸前佩戴姿态检测 · 向左 / 向右侧倾-->
<navigation-bar title="康复训练" back="{{false}}" color="white" background="#0b1220"></navigation-bar>

<view class="root">

  <!-- 顶部数据（超大字） -->
  <view class="topbar">
    <view class="stat">
      <view class="stat-num gold">{{coins}}</view>
      <view class="stat-label">金币</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{reps}}<text class="stat-sub">/{{goal}}</text></view>
      <view class="stat-label">完成次数</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{combo}}</view>
      <view class="stat-label">连击</view>
    </view>
  </view>

  <!-- 主舞台：小人占约 70% 屏幕 -->
  <view class="stage">
    <!-- 大字提示（浮层，不占布局高度） -->
    <view class="tip-bar {{tipType}}">{{tip}}</view>

    <!-- 当前倾斜角度 -->
    <view class="lean-badge">
      <view class="lean-num">{{leanText}}°</view>
      <view class="lean-label">倾斜角度</view>
    </view>

    <!-- 航空姿态仪 -->
    <view class="hud">
      <view class="hud-horizon" style="transform: rotate({{hudRotate}}deg) translateY({{hudShift}}rpx)">
        <view class="hud-sky"></view>
        <view class="hud-line"></view>
        <view class="hud-ground"></view>
      </view>
      <view class="hud-plane"><view class="hud-bar"></view></view>
      <view class="hud-num">{{leanText}}°</view>
    </view>

    <view class="arrow left {{targetDir === 'left' ? 'active' : ''}}">◀ 向左</view>
    <view class="arrow right {{targetDir === 'right' ? 'active' : ''}}">向右 ▶</view>

    <!-- 会跟着一起倾的小人 -->
    <view class="man-wrap" style="transform: rotate({{manRotate}}deg)">
      <view class="man-head"></view>
      <view class="man-body">
        <view class="man-arm arm-l"></view>
        <view class="man-arm arm-r"></view>
      </view>
      <view class="man-legs">
        <view class="man-leg"></view>
        <view class="man-leg"></view>
      </view>
    </view>
  </view>

  <!-- 设置条：仅未开始训练时显示，训练中把空间全部留给小人 -->
  <view class="panel" wx:if="{{phase === 'idle' || phase === 'done'}}">
    <view class="panel-row">
      <view class="panel-label">检测方向</view>
      <view class="seg">
        <view
          class="seg-item {{axis === item.value ? 'on' : ''}}"
          wx:for="{{axisList}}"
          wx:key="value"
          data-axis="{{item.value}}"
          bindtap="onAxisChange"
        >{{item.label}}</view>
      </view>
      <view class="btn-flip" bindtap="onFlipDir">左右反了？点我</view>
    </view>
    <view class="panel-row">
      <view class="panel-label">目标角度</view>
      <view class="seg">
        <view
          class="seg-item {{targetAngle === item.value ? 'on' : ''}}"
          wx:for="{{targets}}"
          wx:key="value"
          data-target="{{item.value}}"
          bindtap="onTargetChange"
        >{{item.label}}</view>
      </view>
      <view class="btn-cal {{status === 'connected' ? '' : 'off'}}" bindtap="onCalibrate">设定基准</view>
    </view>
  </view>

  <!-- 底部中间：连接 -->
  <view class="dock">
    <view class="dock-btn {{status}}" bindtap="onDockTap">
      <view class="dock-dot"></view>
      <view class="dock-text">{{dockText}}</view>
    </view>
    <view class="dock-sub" wx:if="{{status === 'connected'}}" bindtap="onDisconnectTap">断开</view>
  </view>

  <view class="gain" wx:if="{{showGain}}">+{{gainText}}</view>

  <!-- 设备选择浮层 -->
  <view class="mask" wx:if="{{showDevices}}" bindtap="onCloseDevices"></view>
  <view class="dev-panel {{showDevices ? 'show' : ''}}">
    <view class="dev-title">选择要连接的传感器</view>
    <view class="dev-item" wx:for="{{devices}}" wx:key="deviceId" data-id="{{item.deviceId}}" bindtap="onPickDevice">
      <view class="dev-info">
        <view class="dev-name">{{item.name || '未命名设备'}}</view>
        <view class="dev-id">{{item.rssi}} dBm</view>
      </view>
      <view class="dev-go">连接</view>
    </view>
    <view class="dev-empty" wx:if="{{devices.length === 0}}">正在搜索…请确认传感器已开机（蓝灯快闪）</view>
  </view>

</view>
