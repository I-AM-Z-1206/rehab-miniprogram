<!--sensor.wxml-->
<navigation-bar title="加速度传感器" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="page-body">

    <!-- XYZ 数值展示 -->
    <view class="axis-card">
      <view class="axis-row">
        <view class="axis-label x">X</view>
        <view class="axis-value">{{x}}</view>
      </view>
      <view class="axis-divider"></view>
      <view class="axis-row">
        <view class="axis-label y">Y</view>
        <view class="axis-value">{{y}}</view>
      </view>
      <view class="axis-divider"></view>
      <view class="axis-row">
        <view class="axis-label z">Z</view>
        <view class="axis-value">{{z}}</view>
      </view>
    </view>

    <view class="tip">单位：g（重力加速度），静止平放时 Z ≈ 1.000</view>

    <!-- 频率选择 -->
    <view class="control-card">
      <view class="control-title">采集频率</view>
      <view class="freq-group">
        <view
          class="freq-item {{interval === item.value ? 'active' : ''}}"
          wx:for="{{frequencyList}}"
          wx:key="value"
          data-freq="{{item.value}}"
          bindtap="onFrequencyChange"
        >{{item.label}}</view>
      </view>
      <view class="freq-desc">
        {{interval === 'normal' ? '5 次/秒' : interval === 'ui' ? '16 次/秒' : '50 次/秒'}}
      </view>
    </view>

    <!-- 启停按钮 -->
    <view class="btn {{running ? 'btn-stop' : ''}}" bindtap="toggle">
      {{running ? '停止监听' : '开始监听'}}
    </view>

    <view class="status-tip">{{running ? '正在采集加速度数据…' : '已停止'}}</view>

  </view>
</scroll-view>
