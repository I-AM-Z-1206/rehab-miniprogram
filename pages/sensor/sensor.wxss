/**sensor.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f6fa;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-body {
  padding: 24rpx;
}

/* ---------- XYZ 数值卡片 ---------- */
.axis-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.axis-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 0;
}

.axis-label {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 32rpx;
}

.axis-label.x { background-color: #e64340; }
.axis-label.y { background-color: #07c160; }
.axis-label.z { background-color: #10aeff; }

.axis-value {
  flex: 1;
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  font-family: monospace;
  text-align: right;
}

.axis-divider {
  height: 1rpx;
  background-color: #f0f0f0;
}

.tip {
  margin: 20rpx 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* ---------- 控制区 ---------- */
.control-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.control-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

/* ---------- 频率分段按钮 ---------- */
.freq-group {
  display: flex;
  flex-direction: row;
  background-color: #f5f6fa;
  border-radius: 14rpx;
  padding: 6rpx;
}

.freq-item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
}

.freq-item.active {
  background-color: #fff;
  color: #07c160;
  font-weight: 600;
}

.freq-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

/* ---------- 按钮 ---------- */
.btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-stop {
  background-color: #e64340;
}

.status-tip {
  text-align: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}
