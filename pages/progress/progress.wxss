/** progress.wxss —— 我的进步
 *
 * 和首页同一套语言：纯白底、1rpx 细线分区、不堆卡片、不用阴影。
 *
 * 颜色只承担功能：上升=青绿、下降=琥珀、持平/无数据=灰。
 * **不用红色** —— 红色像警报，康复场景会让人紧张。
 *
 * 字号偏大：使用者多为中老年患者，14px 以下的正文字太小。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 20rpx 40rpx 80rpx;
}

/* ---------- 结论 ---------- */
.head {
  padding: 30rpx 0 34rpx;
}

.head-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.head-num {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: -1.5rpx;
  color: var(--ink-1);
}

/* 同首页：没有数据时这里是句子不是数字。76rpx/700 装一句话，字会撞在一起。 */
.head-num.is-text {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.5rpx;
}

.head-arrow {
  margin-left: 16rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.head-arrow.up { color: var(--teal-ink); }
.head-arrow.down { color: var(--amber-ink); }
.head-arrow.flat { color: var(--ink-4); }

.head-say {
  display: block;
  margin-top: 12rpx;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink-2);
}

/* ---------- 分区 ---------- */
.block {
  display: block;
  padding: 32rpx 0;
  border-top: 1rpx solid var(--line);
}

/* 打卡是唯一需要横向一行的分区。
   用 flex-end 而不是 center：「4 / 7 天」要和星期标签站在同一条基线上，
   居中会让它浮在圆点和标签之间，看着像没对齐。 */
.block-week {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
}

/* 分区标题是标签，不是标题：26rpx / ink-3，靠字距和上方细线分开，
   不和下面 32rpx 的实际数据抢注意力 */
.block-title {
  display: block;
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 0.5rpx;
  margin-bottom: 10rpx;
}

.block-note {
  display: block;
  width: 100%;
  font-size: var(--fs-note);
  line-height: 1.7;
  color: var(--ink-3);
}

/* ---------- 本周打卡 ---------- */
.week {
  display: flex;
  flex-direction: row;
  flex: 1;
}

.wk {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 26rpx;
}

.wk-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background-color: var(--line-soft);
  border: 2rpx solid var(--line);
  box-sizing: border-box;
}

.wk.on .wk-dot {
  background-color: var(--teal);
  border-color: var(--teal);
}

.wk.today .wk-dot {
  box-shadow: 0 0 0 5rpx rgba(15, 156, 140, 0.16);
}

.wk-label {
  margin-top: 8rpx;
  font-size: var(--fs-micro);
  color: var(--ink-3);
}

.wk.on .wk-label {
  color: var(--teal-ink);
  font-weight: 600;
}

.week-meta {
  font-size: var(--fs-note);
  line-height: 1.2;
  color: var(--ink-3);
  padding-bottom: 2rpx;
}

.chart {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
}

.cv {
  width: 100%;
  height: 320rpx;
}

/* ---------- 各项训练（表格） ---------- */
.row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  width: 100%;
  padding: 14rpx 0;
}

.row-name {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink-1);
}

/* 「12 次」是弱信息，但 23rpx + #b3b9c2（2.0:1）是直接看不见。
   弱化靠字号和墨色，不靠把对比度压到不可读。 */
.row-count {
  font-size: var(--fs-note);
  color: var(--ink-3);
  margin-right: 24rpx;
}

.row-val {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink-1);
  min-width: 106rpx;
  text-align: right;
}

.row-delta {
  font-size: var(--fs-note);
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.row-delta.up { color: var(--teal-ink); }
.row-delta.down { color: var(--amber-ink); }
.row-delta.flat { color: var(--ink-4); }

/* ---------- 累计 ---------- */
.block-last {
  align-items: baseline;
}

.total-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-1);
}

.total-item {
  margin-left: 8rpx;
  font-size: var(--fs-body-s);
  color: var(--ink-2);
}

.total-sep {
  margin: 0 20rpx;
  color: var(--ink-4);
  font-size: var(--fs-note);
}

/* ---------- 底部 ---------- */
.cta {
  margin-top: 48rpx;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: var(--r-lg);
  text-align: center;
  font-size: var(--fs-h2);
  font-weight: 600;
  color: #ffffff;
  background-color: var(--teal);
}

.cta:active {
  background-color: var(--teal-press);
}

.foot {
  display: block;
  margin-top: 28rpx;
  font-size: var(--fs-note);
  line-height: 1.75;
  color: var(--ink-3);
}
