/** progress.wxss —— 我的进步
 *
 * 视觉原则（和标定页一致）：
 *   1. 纯白底、1rpx 细线分区、靠留白和字号建立层级，不堆白卡片 + 阴影；
 *   2. 颜色只承担功能：上升=青绿、下降=琥珀、持平/无数据=灰。
 *      **不用红色** —— 红色像警报，康复场景会让人紧张；
 *   3. 字号偏大：使用者多为中老年患者，14px 以下的正文字太小。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-body {
  padding: 16rpx 36rpx 72rpx;
}

/* ---------- 主结论 ---------- */
.hero {
  padding: 28rpx 0 32rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.hero-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.hero-num {
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  color: #1c2430;
}

.hero-arrow {
  margin-left: 16rpx;
  font-size: 48rpx;
  font-weight: 700;
}

.hero-arrow.up { color: #12a06a; }
.hero-arrow.down { color: #d98324; }
.hero-arrow.flat { color: #9aa1ad; }

.hero-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #5b6472;
}

/* ---------- 分区 ---------- */
.sec {
  padding: 32rpx 0;
  border-bottom: 1rpx solid #eef1f5;
}

.sec-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2430;
}

.sec-meta {
  font-size: 24rpx;
  color: #9aa1ad;
}

/* ---------- 本周打卡 ---------- */
.days {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.day {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f0f2f5;
  border: 2rpx solid #e4e8ee;
}

.day.on .dot {
  background-color: #0f9c8c;
  border-color: #0f9c8c;
}

/* 今天加一圈外环，但不改填充色：今天没练就不该显示成练过 */
.day.today .dot {
  box-shadow: 0 0 0 6rpx rgba(15, 156, 140, 0.18);
}

/* 还没到的日子：只是稍微淡一点，不能淡到看不见 —— 那会被当成显示坏了 */
.day.future .dot {
  background-color: #f7f9fb;
  border-color: #e6eaf0;
}

.day-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8b8f9a;
}

.day.on .day-label {
  color: #0f9c8c;
  font-weight: 600;
}

.day.future .day-label {
  color: #c8ccd4;
}

/* ---------- 走势 ---------- */
.chart {
  width: 100%;
  height: 320rpx;
}

.cv {
  width: 100%;
  height: 320rpx;
}

.empty {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #9aa1ad;
}

/* ---------- 各项训练 ---------- */
.game {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4f6f9;
}

.game:last-child {
  border-bottom: none;
}

.g-name {
  flex: 1;
  font-size: 30rpx;
  color: #1c2430;
}

.g-count {
  font-size: 24rpx;
  color: #9aa1ad;
  margin-right: 24rpx;
}

.g-val {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c2430;
  min-width: 110rpx;
  text-align: right;
}

.g-delta {
  font-size: 26rpx;
  font-weight: 600;
  min-width: 80rpx;
  text-align: right;
}

.g-delta.up { color: #12a06a; }
.g-delta.down { color: #d98324; }
.g-delta.flat { color: #b9c0ca; }

/* ---------- 累计 ---------- */
.total {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.total-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1c2430;
}

.total-item {
  margin-left: 8rpx;
  font-size: 26rpx;
  color: #5b6472;
}

.total-dot {
  margin: 0 20rpx;
  color: #d3d7de;
  font-size: 26rpx;
}

/* ---------- 底部 ---------- */
.cta {
  margin-top: 40rpx;
  padding: 30rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #0f9c8c;
}

.cta:active {
  opacity: 0.88;
}

.foot {
  display: block;
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9aa1ad;
}
