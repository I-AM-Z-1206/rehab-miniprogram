/** progress.wxss —— 我的进步
 *
 * 和首页同一套语言：纯白底、1rpx 细线分区、不堆卡片、不用阴影。
 *
 * 颜色只承担功能：上升=青绿、下降=琥珀、持平/无数据=灰。
 * **不用红色** —— 红色像警报，康复场景会让人紧张。
 *
 * 字号偏大：使用者多为中老年患者，14px 以下的正文字太小。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 20rpx 40rpx 80rpx;
}

/* ---------- 结论 ---------- */
.head {
  padding: 30rpx 0 34rpx;
}

.head-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.head-num {
  font-size: 76rpx;
  font-weight: 700;
  letter-spacing: -1.5rpx;
  color: #1a1f26;
}

.head-arrow {
  margin-left: 16rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.head-arrow.up { color: #0f9c8c; }
.head-arrow.down { color: #c47b1f; }
.head-arrow.flat { color: #a8aeb8; }

.head-say {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #4a515c;
}

/* ---------- 分区 ---------- */
.block {
  display: block;
  padding: 32rpx 0;
  border-top: 1rpx solid #eceff3;
}

/* 打卡是唯一需要横向一行的分区 */
.block-week {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.block-title {
  display: block;
  font-size: 26rpx;
  color: #949aa3;
  margin-bottom: 6rpx;
}

.block-note {
  display: block;
  width: 100%;
  font-size: 25rpx;
  line-height: 1.7;
  color: #a8aeb8;
}

/* ---------- 本周打卡 ---------- */
.week {
  display: flex;
  flex-direction: row;
  flex: 1;
}

.wk {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 26rpx;
}

.wk-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background-color: #f2f4f7;
  border: 2rpx solid #e6eaf0;
  box-sizing: border-box;
}

.wk.on .wk-dot {
  background-color: #0f9c8c;
  border-color: #0f9c8c;
}

.wk.today .wk-dot {
  box-shadow: 0 0 0 5rpx rgba(15, 156, 140, 0.16);
}

.wk-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b3b9c2;
}

.wk.on .wk-label {
  color: #0f9c8c;
}

.week-meta {
  font-size: 24rpx;
  color: #949aa3;
}

.chart {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
}

.cv {
  width: 100%;
  height: 320rpx;
}

/* ---------- 各项训练（表格） ---------- */
.row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  width: 100%;
  padding: 14rpx 0;
}

.row-name {
  flex: 1;
  font-size: 29rpx;
  color: #1a1f26;
}

.row-count {
  font-size: 23rpx;
  color: #b3b9c2;
  margin-right: 24rpx;
}

.row-val {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1f26;
  min-width: 106rpx;
  text-align: right;
}

.row-delta {
  font-size: 25rpx;
  font-weight: 600;
  min-width: 76rpx;
  text-align: right;
}

.row-delta.up { color: #0f9c8c; }
.row-delta.down { color: #c47b1f; }
.row-delta.flat { color: #b3b9c2; }

/* ---------- 累计 ---------- */
.block-last {
  align-items: baseline;
}

.total-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1f26;
}

.total-item {
  margin-left: 8rpx;
  font-size: 25rpx;
  color: #4a515c;
}

.total-sep {
  margin: 0 20rpx;
  color: #d3d7de;
  font-size: 25rpx;
}

/* ---------- 底部 ---------- */
.cta {
  margin-top: 48rpx;
  padding: 30rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #0f9c8c;
}

.cta:active {
  background-color: #0d8b7d;
}

.foot {
  display: block;
  margin-top: 28rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: #a8aeb8;
}
