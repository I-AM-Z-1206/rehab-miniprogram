<!--progress.wxml —— 我的进步（患者端）-->
<navigation-bar title="我的进步" back="{{true}}" color="black" background="#ffffff"></navigation-bar>

<scroll-view class="scrollarea" scroll-y>
  <view class="page">

    <!-- 结论在前：患者要知道的是「我在变好」，不是记住 68% 这个绝对值。
         但 headline 在无数据时是一句话（「还没有训练数据」），不是数字 ——
         tone 为 none 时切到 is-text，把 76rpx 让给真正的数字。 -->
    <view class="head">
      <view class="head-line">
        <text class="head-num {{tone === 'none' ? 'is-text' : ''}}">{{headline}}</text>
        <text class="head-arrow {{tone}}" wx:if="{{arrow}}">{{arrow}}</text>
      </view>
      <text class="head-say">{{detailText}}</text>
    </view>

    <!-- 本周打卡：紧凑一行。中断的日子不做任何标记 —— 不打叉、不显示「漏」 -->
    <view class="block block-week">
      <view class="week">
        <view class="wk {{item.trained ? 'on' : ''}} {{item.today ? 'today' : ''}} {{item.future ? 'future' : ''}}"
              wx:for="{{week}}" wx:key="label">
          <view class="wk-dot"></view>
          <text class="wk-label">{{item.label}}</text>
        </view>
      </view>
      <text class="week-meta">{{trainedDays}} / 7 天</text>
    </view>

    <!-- 走势：一条线，不做多条 -->
    <view class="block">
      <text class="block-title">稳定率走势</text>
      <view class="chart" wx:if="{{hasChart}}">
        <canvas type="2d" id="chartTrend" class="cv"></canvas>
      </view>
      <text class="block-note" wx:else>再练几次就能看到走势。少于 3 次不画线 —— 一两次的波动容易被当成趋势。</text>
    </view>

    <!-- 各项训练：表格，不是卡片列表 -->
    <view class="block">
      <text class="block-title">各项训练</text>
      <view class="row" wx:for="{{games}}" wx:key="name">
        <text class="row-name">{{item.name}}</text>
        <text class="row-count">{{item.count}} 次</text>
        <text class="row-val">{{item.value}}</text>
        <text class="row-delta {{item.tone}}" wx:if="{{item.delta}}">{{item.delta}}</text>
      </view>
      <text class="block-note" wx:if="{{!games.length}}">还没有训练记录。完成一局任意训练，这里就会开始统计。</text>
    </view>

    <!-- 累计：只增不减，中断也不会倒退 -->
    <view class="block block-last">
      <text class="total-num">{{totalCount}}</text>
      <text class="total-item">次训练</text>
      <text class="total-sep">·</text>
      <text class="total-num">{{totalMinutes}}</text>
      <text class="total-item">分钟</text>
    </view>

    <!-- 一次都没练过时说「继续训练」是错的 —— 没有可继续的东西 -->
    <view class="cta" bindtap="goGames" aria-role="button" aria-label="{{totalCount > 0 ? '继续训练，去挑一个游戏' : '开始第一次训练，去挑一个游戏'}}">{{totalCount > 0 ? '继续训练' : '开始第一次训练'}}</view>
    <text class="foot">稳定率 = 身体待在目标范围内的时长占比，不是游戏分数。难度调高时暂时下降是正常的。</text>

  </view>
</scroll-view>
