<!--shoot.wxml —— FR-GAME-01 射击训练：体感保持 + 自动开火 + 治疗师实时面板-->
<navigation-bar title="射击训练" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page">

  <!-- ============ 游戏舞台（Canvas 2D） ============ -->
  <view class="stage">
    <canvas
      type="2d"
      id="gameCanvas"
      class="game-canvas"
      bindtap="onCanvasTap"
      bindtouchstart="onStageTouch"
      bindtouchmove="onStageTouch"
    ></canvas>
  </view>

  <!-- ============ 状态条（不放在 canvas 之上，避免原生组件遮挡） ============ -->
  <view class="strip">
    <view class="strip-chip {{sensorConnected ? 'ok' : 'off'}}" bindtap="goConnect">
      <text class="chip-dot"></text>
      <text>{{sensorConnected ? '传感器已连接' : '未连接 · 点击连接'}}</text>
    </view>
    <view class="strip-chip sim" wx:if="{{sensorStale}}">触屏模拟</view>
    <view class="strip-chip {{sensorHz > 0 ? 'ok' : ''}}" wx:if="{{sensorConnected}}">{{sensorHz}}Hz</view>
    <view class="strip-chip {{inZone ? 'ok' : 'bad'}}">倾角 {{angle}}°</view>
    <view class="strip-chip bad" wx:if="{{!inZone}}">{{outWarn || '已超出保持范围'}}</view>
    <view class="strip-right">{{timeLeft}}s</view>
  </view>

  <!-- ============ 治疗师控制台 ============ -->
  <view class="panel {{panelOpen ? 'open' : 'closed'}}">

    <view class="panel-head" bindtap="onTogglePanel">
      <view class="panel-title">
        <image class="ico ico-xs" src="/assets/icons/sliders-horizontal-teal.png" mode="aspectFit" />
        <text>治疗师控制台</text>
      </view>
      <view class="panel-meta">{{difficultyLabel}} · {{score}} 分 · 连击 x{{combo}}</view>
      <view class="panel-toggle">{{panelOpen ? '收起' : '展开'}}</view>
    </view>

    <scroll-view class="panel-scroll" scroll-y wx:if="{{panelOpen}}">
      <!-- 操作 -->
      <view class="act-row">
        <view class="btn primary {{running ? 'paused' : ''}}" bindtap="onActionTap">
          <image class="btn-ico" src="{{btnIcon}}" mode="aspectFit" />
          <text>{{btnText}}</text>
        </view>
        <view class="btn ghost" bindtap="onRestart">
          <image class="btn-ico" src="/assets/icons/rotate-ccw-teal.png" mode="aspectFit" />
          <text>重来</text>
        </view>
        <view class="btn ghost" bindtap="onResetParams">恢复默认</view>
      </view>

      <!-- 实时数据 -->
      <view class="live-row">
        <view class="live-cell">
          <text class="live-num">{{score}}</text>
          <text class="live-label">得分</text>
        </view>
        <view class="live-cell">
          <text class="live-num accent">x{{combo}}</text>
          <text class="live-label">连击</text>
        </view>
        <view class="live-cell">
          <text class="live-num">{{hits}}</text>
          <text class="live-label">命中</text>
        </view>
        <view class="live-cell">
          <text class="live-num">{{zoneRate}}%</text>
          <text class="live-label">在界率</text>
        </view>
      </view>

      <!-- 难度档位 -->
      <view class="sec-mini">难度档位（切换后仍可单项微调）</view>
      <view class="diff-row">
        <view
          wx:for="{{difficulties}}"
          wx:key="key"
          class="diff {{item.active ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onDifficultyTap"
        >{{item.label}}</view>
        <view class="diff-mul">得分系数 x{{scoreMul}}</view>
      </view>

      <!-- 实时参数 -->
      <view class="sec-mini">实时参数（拖动立即生效，无需重启）</view>
      <view class="param" wx:for="{{params}}" wx:key="key">
        <view class="param-head">
          <text class="param-label">{{item.label}}</text>
          <text class="param-val">{{item.display}}</text>
        </view>
        <slider
          class="param-slider"
          min="{{item.min}}"
          max="{{item.max}}"
          step="{{item.step}}"
          value="{{item.value}}"
          data-key="{{item.key}}"
          activeColor="#0f9c8c"
          backgroundColor="#e6ebf0"
          block-size="20"
          bindchanging="onParamChanging"
          bindchange="onParamChanging"
        />
      </view>

      <!-- 开关 -->
      <view class="switch-row">
        <view class="switch-item">
          <text class="switch-label">显示判定圈</text>
          <switch checked="{{showHitArea}}" bindchange="onToggleHitArea" color="#0f9c8c" />
        </view>
        <view class="switch-item">
          <text class="switch-label">音效</text>
          <switch checked="{{sfxOn}}" bindchange="onToggleSfx" color="#0f9c8c" />
        </view>
        <view class="switch-item">
          <text class="switch-label">音乐</text>
          <switch checked="{{bgmOn}}" bindchange="onToggleBgm" color="#0f9c8c" />
        </view>
      </view>

      <view class="panel-tip">
        训练要点：屏幕中间的小怪兽是固定目标，身体保持在绿色“保持区”内会持续自动开火；
        偏出保持区时子弹仍然发射，但画面会提示回到中间，并暂停每秒基础分。
        左右移动读取 Pitch（按实机佩戴方向），小人按镜像方向跟随。
        治疗师可在训练过程中实时调整判定范围、发射频率与保持范围，参数会自动保存。
      </view>
    </scroll-view>
  </view>
</view>
