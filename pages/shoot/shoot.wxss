/*shoot.wxss —— 射击训练页：深色舞台 + 白色治疗师面板*/

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #070d1c;
}

.page {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---------------- 舞台 ---------------- */
.stage {
  position: relative;
  flex: 1;
  min-height: 320rpx;
  overflow: hidden;
  background-color: #070d1c;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* ---------------- 状态条 ---------------- */
.strip {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  padding: 10rpx 20rpx;
  background-color: #0b1424;
  border-top: 1rpx solid rgba(90, 140, 180, 0.18);
}

.strip-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  color: #cfe3f5;
  background-color: rgba(22, 42, 66, 0.9);
  border: 1rpx solid rgba(120, 170, 210, 0.25);
}

.strip-chip.ok {
  color: #7dffcf;
  border-color: rgba(125, 255, 207, 0.4);
}

.strip-chip.off {
  color: #ffd166;
  border-color: rgba(255, 209, 102, 0.4);
}

.strip-chip.sim {
  color: #9fe8ff;
  border-color: rgba(159, 232, 255, 0.35);
}

.strip-chip.bad {
  color: #ffb3ad;
  border-color: rgba(255, 120, 110, 0.5);
}

.strip-right {
  flex: 1;
  text-align: right;
  font-size: 21rpx;
  color: #9fb6cc;
}

.chip-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background-color: currentColor;
}

/* ---------------- 面板 ---------------- */
.panel {
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.18);
}

.panel-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.panel-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
}

.panel-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

.panel-meta {
  flex: 1;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #8b8f9a;
}

.panel-toggle {
  font-size: 23rpx;
  color: #0f9c8c;
}

.panel-scroll {
  height: 46vh;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* ---------------- 操作按钮 ---------------- */
.act-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 0 8rpx;
}

.btn {
  height: 76rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.btn-ico {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.btn.primary {
  flex: 1.4;
  color: #fff;
  background: linear-gradient(135deg, #13b39f 0%, #0f9c8c 100%);
}

.btn.primary.paused {
  background: linear-gradient(135deg, #ffb44d 0%, #f08c1e 100%);
}

.btn.ghost {
  flex: 1;
  margin-left: 16rpx;
  color: #4a5058;
  background-color: #f4f6f8;
}

/* ---------------- 实时数据 ---------------- */
.live-row {
  display: flex;
  flex-direction: row;
  padding: 18rpx 0 10rpx;
}

.live-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.live-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2329;
}

.live-num.accent {
  color: #f0a020;
}

.live-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9aa0a6;
}

.status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  padding: 6rpx 0 14rpx;
}

.status-item {
  font-size: 22rpx;
  color: #7a7f8a;
  margin-right: 22rpx;
}

.status-item.ok {
  color: #0f9c8c;
}

.status-item.bad {
  color: #e0533f;
}

.mono {
  font-family: Menlo, Consolas, monospace;
  color: #1f2329;
}

/* ---------------- 难度 ---------------- */
.sec-mini {
  margin: 18rpx 0 12rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #55595f;
}

.diff-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}

.diff {
  padding: 12rpx 28rpx;
  margin: 0 14rpx 12rpx 0;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #55595f;
  background-color: #f4f6f8;
  border: 1rpx solid transparent;
}

.diff.active {
  color: #0f9c8c;
  background-color: #e7f7f4;
  border-color: #0f9c8c;
  font-weight: 600;
}

.diff-mul {
  font-size: 21rpx;
  color: #9aa0a6;
}

/* ---------------- 滑块 ---------------- */
.param {
  padding: 6rpx 0 2rpx;
}

.param-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rpx;
}

.param-label {
  font-size: 24rpx;
  color: #3d434a;
}

.param-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f9c8c;
  font-family: Menlo, Consolas, monospace;
}

.param-slider {
  margin: 0 0 8rpx;
}

/* ---------------- 开关 ---------------- */
.switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  padding: 12rpx 0 4rpx;
}

.switch-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 26rpx;
}

.switch-label {
  font-size: 23rpx;
  color: #55595f;
  margin-right: 8rpx;
}

.panel-tip {
  padding: 16rpx 0 40rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9aa0a6;
}
