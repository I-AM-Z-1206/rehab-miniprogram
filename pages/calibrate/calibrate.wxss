/** calibrate.wxss —— 零点标定页 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f6fa;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-body {
  padding: 24rpx;
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 18rpx;
}

.flex-spacer {
  flex: 1;
}

.mono {
  font-family: monospace;
}

/* ---------- 状态 ---------- */
.status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #ccc;
  margin-right: 14rpx;
}

.status-dot.on {
  background-color: #0f9c8c;
  box-shadow: 0 0 8rpx rgba(15, 156, 140, 0.6);
}

.status-dot.scan {
  background-color: #ffc34d;
  animation: blink 800ms infinite;
}

@keyframes blink {
  0% { opacity: 1; }
  50% { opacity: 0.25; }
  100% { opacity: 1; }
}

.status-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.btn-mini {
  padding: 10rpx 30rpx;
  border-radius: 28rpx;
  background-color: #0f9c8c;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-mini.btn-stop {
  background-color: #ffc34d;
}

/* ---------- 设备列表 ---------- */
.dev-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f3f5;
}

.dev-info {
  flex: 1;
  overflow: hidden;
}

.dev-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.dev-id {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #bbb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-rssi {
  font-size: 22rpx;
  color: #999;
  margin-right: 20rpx;
}

.dev-connect {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background-color: #0f9c8c;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-tip {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

/* ---------- 标定控制 ---------- */
.cal-desc {
  font-size: 24rpx;
  color: #8b8f9a;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.cal-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 24rpx;
}

.cal-count {
  font-size: 72rpx;
  font-weight: 700;
  color: #0f9c8c;
}

.cal-progress {
  width: 100%;
  margin: 16rpx 0 12rpx;
}

.cal-tip {
  font-size: 24rpx;
  color: #8b8f9a;
}

.cal-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background-color: #0f9c8c;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.cal-btn.off {
  background-color: #c9cdd4;
}

.cal-btn.running {
  background-color: #ffc34d;
  color: #6b4a00;
}

/* ---------- 姿态虚拟零点 ---------- */
.zero-grid {
  display: flex;
  flex-direction: row;
  padding: 6rpx 0 18rpx;
}

.zero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.zero-label {
  font-size: 20rpx;
  color: #9aa0a6;
  margin-bottom: 8rpx;
  text-align: center;
}

.zero-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  white-space: nowrap;
}

.zero-val.accent {
  color: #0f9c8c;
}

.zero-state {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
  background-color: #f5f6fa;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-bottom: 20rpx;
}

.zero-state.on {
  background-color: #e8f6f4;
  color: #0f9c8c;
}

.zero-state-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #c9cdd4;
  margin-right: 12rpx;
}

.zero-state.on .zero-state-dot {
  background-color: #0f9c8c;
}

.btn-row {
  display: flex;
  flex-direction: row;
}

.cal-btn2 {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background-color: #0f9c8c;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.cal-btn2:last-child {
  margin-right: 0;
}

.cal-btn2.off {
  background-color: #c9cdd4;
}

.cal-btn2.running {
  background-color: #ffc34d;
  color: #6b4a00;
}

.cal-btn2.ghost {
  background-color: #f5f6fa;
  color: #666;
  font-weight: 600;
  border: 2rpx solid #e4e6eb;
  box-sizing: border-box;
}

/* ---------- 结果 ---------- */
.val-grid {
  display: flex;
  flex-direction: row;
}

.val-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.val-axis {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.val-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f9c8c;
}

.res-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

/* ---------- 图表 ---------- */
.chart-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.chart-box {
  width: 100%;
  height: 360rpx;
}

/* 姿态实时曲线（Roll / Pitch 并排） */
.zero-charts {
  display: flex;
  flex-direction: row;
  margin: 8rpx 0 20rpx;
}

.zero-chart-item {
  flex: 1;
  min-width: 0;
}

.zero-chart-item + .zero-chart-item {
  margin-left: 16rpx;
}

.zero-chart-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.chart-box-sm {
  width: 100%;
  height: 200rpx;
}

/* ---------- 说明 ---------- */
.help-tip {
  margin-top: 4rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background-color: #fff6e2;
  font-size: 22rpx;
  color: #96700a;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
