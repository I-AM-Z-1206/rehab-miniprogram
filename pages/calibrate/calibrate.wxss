/** calibrate.wxss —— 零点标定页
 *
 * 结构说明（针对之前"反人类"的反馈做过一轮重排）：
 *   结论（当前角度 + 标没标定）在最上面，姿态分布在按钮上方，说明是一句话放在最后。
 *
 * 这一版只统一"皮肤"，不动结构：
 *   - 灰原来是第三套（#1a1d21 / #8b9198 / #a1a1aa），和首页的 #1a1f26 / #949aa3 / #a8aeb8
 *     不是同一个体系，两页之间翻动时字色会跳。现在全部走令牌。
 *   - 警告色原来是 #e8845a —— 那是珊瑚红。项目自己的规则是「康复场景不用红，红色像警报」，
 *     这里却用它标"标准差偏大"。改成琥珀。
 *   - 22-25rpx 的标签（图例、统计项、提示）提到 24-26rpx 下限。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-body {
  padding: 8rpx var(--pad-x) 64rpx;
}

.mono {
  font-family: monospace;
}

.spacer { flex: 1; }

/* ---------- 传感器状态行 ---------- */
.bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ccd2da;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot.on {
  background-color: var(--teal);
}

.dot.scan {
  background-color: var(--amber);
  animation: pulse 800ms infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

.bar-text {
  font-size: var(--fs-body-s);
  color: var(--ink-1);
}

/* 链接文字必须用加深版青色：#0f9c8c 在白底上只有 3.4:1，26rpx 的正文达不到 4.5:1 */
.link {
  font-size: var(--fs-body-s);
  color: var(--teal-ink);
  padding: 12rpx 4rpx;
}

.link-stop { color: var(--amber-ink); }

/* ---------- 设备列表 ---------- */
.dev {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.dev:active { opacity: 0.55; }

.dev-l {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dev-name {
  font-size: var(--fs-body);
  color: var(--ink-1);
}

.dev-id {
  font-size: var(--fs-micro);
  color: var(--ink-4);
  margin-top: 4rpx;
}

.dev-rssi {
  font-size: var(--fs-note);
  color: var(--ink-3);
  margin-right: 20rpx;
}

.dev-go {
  font-size: var(--fs-body-s);
  font-weight: 600;
  color: var(--teal-ink);
}

/* ---------- 标题 ---------- */
.h1 {
  font-size: var(--fs-h1);
  font-weight: 700;
  color: var(--ink-1);
  margin: 44rpx 0 28rpx;
  letter-spacing: -0.5rpx;
}

/* ---------- 当前读数：这一屏最该被看到的信息 ---------- */
.readout {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background-color: #f7f9fa;
  border-radius: var(--r-md);
  padding: 36rpx 0;
  margin-bottom: 20rpx;
}

.ro-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ro-sep {
  width: 1rpx;
  background-color: var(--line);
  margin: 8rpx 0;
}

.ro-num {
  font-size: 62rpx;
  font-weight: 500;
  color: var(--ink-1);
  line-height: 1.1;
}

.ro-unit {
  font-size: var(--fs-body-s);
  color: var(--ink-3);
  margin-left: 2rpx;
}

.ro-label {
  font-size: var(--fs-note);
  color: var(--ink-3);
  margin-top: 10rpx;
}

/* ---------- 状态徽章 ---------- */
.badge {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
  border-radius: var(--r-sm);
  font-size: var(--fs-note);
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.badge-on {
  background-color: var(--teal-wash);
  color: var(--teal-ink);
}

.badge-on .badge-dot { background-color: var(--teal); }

.badge-off {
  background-color: var(--amber-wash);
  color: var(--amber-ink);
}

.badge-off .badge-dot { background-color: var(--amber); }

/* ---------- 主操作 ---------- */
.acts {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}

.btn-primary {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background-color: var(--teal);
  color: #ffffff;
  font-size: var(--fs-h2);
  font-weight: 600;
  border-radius: var(--r-lg);
}

.btn-primary:active {
  background-color: var(--teal-press);
}

.btn-primary.disabled {
  background-color: #c9d3d1;
}

.btn-plain {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--fs-body-s);
  color: var(--ink-3);
  padding: 20rpx 0;
}

/* ---------- 标定中 ---------- */
.running {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 40rpx;
  margin-bottom: 36rpx;
}

/* 只有 .ring-track 旋转，数字层 .ring-body 绝对定位盖在上面，保持不动 */
.ring {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  margin-bottom: 28rpx;
}

.ring-track {
  position: absolute;
  left: 0;
  top: 0;
  width: 168rpx;
  height: 168rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 6rpx solid var(--teal);
  border-top-color: var(--teal-wash);
  animation: spin 1s linear infinite;
}

.ring-body {
  position: absolute;
  left: 0;
  top: 0;
  width: 168rpx;
  height: 168rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.ring-num {
  font-size: 60rpx;
  font-weight: 500;
  color: var(--teal-ink);
  line-height: 1;
}

.ring-unit {
  font-size: var(--fs-micro);
  color: var(--teal-ink);
  margin-left: 2rpx;
}

.ring-text {
  font-size: var(--fs-body-s);
  color: var(--ink-2);
}

/* ---------- 结果：用列表而不是三个并排格子 ---------- */
.result {
  border-top: 1rpx solid var(--line);
  padding-top: 8rpx;
  margin-bottom: 36rpx;
}

.res-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.res-k {
  font-size: var(--fs-body-s);
  color: var(--ink-3);
}

.res-v {
  font-size: var(--fs-body);
  color: var(--ink-1);
}

.res-v.ok { color: var(--teal-ink); }
.res-v.warn { color: var(--amber-ink); }

/* ---------- 折叠区 ---------- */
.fold {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx 0;
  border-top: 1rpx solid var(--line);
  font-size: var(--fs-body-s);
  color: var(--ink-2);
}

.fold:active { opacity: 0.55; }

.fold-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-right: 3rpx solid var(--ink-4);
  border-bottom: 3rpx solid var(--ink-4);
  transform: rotate(45deg);
  transition: transform 200ms;
}

.fold-arrow.up {
  transform: rotate(-135deg);
}

.detail {
  padding-bottom: 20rpx;
}

.sub {
  font-size: var(--fs-note);
  color: var(--ink-2);
  margin: 24rpx 0 12rpx;
}

.chart {
  height: 200rpx;
  background-color: #fafbfc;
  border-radius: var(--r-sm);
}

.chart-lg {
  height: 440rpx;
}

.cv {
  width: 100%;
  height: 100%;
}

/* ---------- 图例与统计 ---------- */
.legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 20rpx 0 24rpx;
}

.lg {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-right: 32rpx;
  font-size: var(--fs-note);
  color: var(--ink-3);
}

.sw {
  width: 26rpx;
  height: 10rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

.sw-sd { background-color: var(--teal); }
.sw-range { background-color: #8fd4cb; }
.sw-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--amber);
  margin-right: 10rpx;
}

.stats {
  display: flex;
  flex-direction: row;
  background-color: #fafbfc;
  border-radius: var(--r-sm);
  padding: 24rpx 0;
}

.st {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.st-n {
  font-size: var(--fs-h2);
  color: var(--ink-1);
}

.st-n.ok { color: var(--teal-ink); }
.st-n.warn { color: var(--amber-ink); }

.st-l {
  font-size: var(--fs-micro);
  color: var(--ink-4);
  margin-top: 8rpx;
}

/* ---------- 说明与提示：一句话，放在最后 ---------- */
.note {
  font-size: var(--fs-note);
  color: var(--ink-3);
  line-height: 1.7;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--line);
}

.hint {
  font-size: var(--fs-note);
  color: var(--ink-3);
  padding: 12rpx 0;
}

/* ---------- 标定时的姿态分布（按钮上方，常驻） ----------
   放在这里的原因：两条实时曲线只是两个数字在滚动，看不出「稳不稳」；
   这张散点图（点云 + 1σ 范围 + 抖动幅度）才是按下标定前的判断依据。 */
.zero {
  margin: 8rpx 0 24rpx;
}

.zero-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.zero-title {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-1);
}

.zero-hint {
  font-size: var(--fs-note);
  color: var(--ink-3);
}

/* 比原来的 440rpx 稍矮：它要让出首屏空间给下面的标定按钮 */
.chart-zero {
  height: 400rpx;
}
