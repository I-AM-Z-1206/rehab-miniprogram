/**wit.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f6fa;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page-body {
  padding: 24rpx;
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 18rpx;
}

.flex-spacer {
  flex: 1;
}

/* ---------- 状态 ---------- */
.status-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #ccc;
  margin-right: 14rpx;
}

.status-dot.on {
  background-color: #0f9c8c;
  box-shadow: 0 0 8rpx rgba(15, 156, 140, 0.6);
}

.status-dot.scan {
  background-color: #ffc34d;
  animation: blink 800ms infinite;
}

@keyframes blink {
  0% { opacity: 1; }
  50% { opacity: 0.25; }
  100% { opacity: 1; }
}

.status-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.packet-count {
  font-size: 24rpx;
  color: #999;
}

/* ---------- 按钮 ---------- */
.btn-row {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
}

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background-color: #0f9c8c;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.btn:last-child {
  margin-right: 0;
}

.btn-stop {
  background-color: #ffc34d;
}

.btn-outline {
  background-color: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  box-sizing: border-box;
}

.btn-disabled {
  opacity: 0.5;
}

.btn-sub {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background-color: #e8f6f4;
  color: #0f9c8c;
  font-size: 26rpx;
}

/* ---------- 设备列表 ---------- */
.dev-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 2rpx solid #f2f3f5;
}

.dev-info {
  flex: 1;
  overflow: hidden;
}

.dev-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.dev-id {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #bbb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-rssi {
  font-size: 22rpx;
  color: #999;
  margin-right: 20rpx;
}

.dev-connect {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background-color: #0f9c8c;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-tip {
  padding: 24rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

/* ---------- 实时数据 ---------- */
.val-grid {
  display: flex;
  flex-direction: row;
}

.val-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.val-axis {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.val-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f9c8c;
}

.mono {
  font-family: monospace;
}

.raw-line {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a3a9b4;
}

/* ---------- 传感器状态 ---------- */
.stat-row {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}

.stat-item {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.bat-volt {
  font-size: 22rpx;
  color: #999;
}

/* ---------- 说明 ---------- */
.help-tip {
  margin-top: 4rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background-color: #fff6e2;
  font-size: 22rpx;
  color: #96700a;
  line-height: 1.6;
  margin-bottom: 40rpx;
}
