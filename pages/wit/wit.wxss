/** wit.wxss —— 蓝牙传感器
 *
 * 和全站同一套语言：纯白底、1rpx 细线、不放卡片、不用阴影。
 * 首屏只回答一个问题：连上了吗、现在姿势是什么。
 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.page {
  padding: 8rpx var(--pad-x) 80rpx;
}

.mono {
  font-family: monospace;
}

.spacer {
  flex: 1;
}

/* ---------- 连接状态 ---------- */
.bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 0 24rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ccd2da;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.dot.on {
  background-color: var(--teal);
}

.dot.scan {
  background-color: var(--amber);
  animation: pulse 800ms infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

.bar-text {
  flex: 1;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink-1);
}

/* ---------- 按钮 ---------- */
/* 圆角 24rpx 与首页主按钮一致；原来这里和标定页各用胶囊/16rpx 两套 */
.btn-row {
  display: flex;
  flex-direction: row;
}

.btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: var(--r-lg);
  background-color: var(--teal);
  color: #ffffff;
  font-size: var(--fs-body);
  font-weight: 600;
  margin-right: 16rpx;
  transition: background-color 0.15s ease;
}

.btn:active {
  background-color: var(--teal-press);
}

.btn:last-child {
  margin-right: 0;
}

.btn-stop {
  background-color: var(--amber);
}

.btn-outline {
  background-color: #ffffff;
  color: var(--ink-2);
  border: 2rpx solid var(--line);
  box-sizing: border-box;
}

.btn-off {
  color: var(--ink-4);
  border-color: var(--line-soft);
}

/* ---------- 分区标题 ---------- */
.sec {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 48rpx 0 8rpx;
}

.sec-title {
  font-size: var(--fs-note);
  font-weight: 600;
  color: var(--ink-3);
  letter-spacing: 1rpx;
}

.sec-hint {
  font-size: var(--fs-note);
  color: var(--ink-3);
}

/* ---------- 设备列表 ---------- */
.dev {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.dev:active {
  opacity: 0.55;
}

.dev-l {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.dev-name {
  font-size: var(--fs-body);
  color: var(--ink-1);
}

.dev-id {
  margin-top: 6rpx;
  font-size: var(--fs-micro);
  color: var(--ink-4);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-rssi {
  font-size: var(--fs-note);
  color: var(--ink-3);
  margin-right: 20rpx;
}

.dev-go {
  font-size: var(--fs-body-s);
  font-weight: 600;
  color: var(--teal-ink);
  padding: 8rpx 4rpx;
}

.hint {
  display: block;
  padding: 24rpx 0;
  font-size: var(--fs-note);
  line-height: 1.6;
  color: var(--ink-3);
}

/* ---------- 姿态角 ---------- */
.angles {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 28rpx 0 8rpx;
}

.ang {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ang-sep {
  width: 1rpx;
  background-color: var(--line);
  margin: 4rpx 0;
}

.ang-num {
  font-size: 56rpx;
  font-weight: 600;
  color: var(--ink-1);
  line-height: 1.1;
}

.ang-unit {
  font-size: var(--fs-body-s);
  color: var(--ink-3);
  margin-left: 2rpx;
}

.ang-label {
  margin-top: 10rpx;
  font-size: var(--fs-note);
  color: var(--ink-3);
}

/* ---------- 电量 ---------- */
.bat {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.bat-ico {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.bat-label {
  font-size: var(--fs-body);
  color: var(--ink-2);
  margin-right: 16rpx;
}

.bat-num {
  font-size: var(--fs-h2);
  font-weight: 600;
  color: var(--ink-1);
}

.bat-volt {
  margin-left: 12rpx;
  font-size: var(--fs-micro);
  color: var(--ink-4);
}

.bat-btn {
  font-size: var(--fs-body-s);
  font-weight: 600;
  color: var(--teal-ink);
  padding: 12rpx 0 12rpx 24rpx;
}

/* ---------- 折叠 ---------- */
.fold {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 30rpx 0;
}

.fold:active {
  opacity: 0.55;
}

.fold-text {
  font-size: var(--fs-body-s);
  color: var(--ink-2);
}

.fold-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-right: 3rpx solid var(--ink-4);
  border-bottom: 3rpx solid var(--ink-4);
  transform: rotate(45deg);
  transition: transform 200ms;
}

.fold-arrow.up {
  transform: rotate(-135deg);
}

/* ---------- 技术数据 ---------- */
.detail {
  display: flex;
  flex-direction: column;
  padding-bottom: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}

.d-sec {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.d-title {
  display: block;
  font-size: var(--fs-note);
  color: var(--ink-3);
  margin-bottom: 18rpx;
}

.vals {
  display: flex;
  flex-direction: row;
}

.val {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.val-axis {
  font-size: var(--fs-micro);
  color: var(--ink-4);
  margin-bottom: 8rpx;
}

.val-num {
  font-size: var(--fs-h2);
  color: var(--ink-1);
}

.d-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 0;
}

.d-k {
  font-size: var(--fs-note);
  color: var(--ink-3);
}

.d-v {
  font-size: var(--fs-note);
  color: var(--ink-1);
  text-align: right;
}

.d-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--r-md);
  background-color: var(--teal-wash);
  color: var(--teal-ink);
  font-size: var(--fs-body-s);
  font-weight: 600;
}

/* ---------- 说明 ---------- */
.note {
  display: block;
  margin-top: 40rpx;
  font-size: var(--fs-note);
  line-height: 1.75;
  color: var(--ink-3);
}
