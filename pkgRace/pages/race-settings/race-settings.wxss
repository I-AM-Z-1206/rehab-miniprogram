/*race-settings.wxss —— 体感赛车训练设置：与项目统一卡片规范（28rpx 圆角 / 1rpx 边框 / 柔和阴影）*/

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6fa;
}

.body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 60rpx;
}

/* ---------------- 摘要 ---------------- */
.hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #e8f6f3 0%, #eaf2fb 100%);
  border: 1rpx solid rgba(15, 156, 140, 0.10);
  box-shadow: 0 8rpx 26rpx rgba(15, 40, 70, 0.05);
}

.hero-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.hero-kicker {
  font-size: 22rpx;
  color: #7a8fa1;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #13293a;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7a8fa1;
}

.hero-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0a7e72;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(15, 156, 140, 0.18);
}

/* ---------------- 提示 ---------------- */
.alert {
  display: flex;
  flex-direction: column;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: #fdf6ea;
  border: 1rpx solid rgba(227, 154, 50, 0.24);
}

.alert-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #9a6414;
}

.alert-line {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8a6b36;
}

/* ---------------- 卡片 ---------------- */
.card {
  padding: 26rpx 26rpx 18rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid #f0f2f5;
  box-shadow: 0 8rpx 28rpx rgba(15, 40, 70, 0.05);
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #13293a;
}

.card-sub {
  font-size: 21rpx;
  color: #9aa6b2;
}

.card-tip {
  display: block;
  margin: 6rpx 0 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9aa0a6;
}

.card-tip.small {
  margin: 14rpx 0 4rpx;
  font-size: 20rpx;
  color: #b0b6bd;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  color: #8b8f9a;
  background: #f2f4f6;
}

.tag.ok {
  color: #0a7e72;
  background: #e6f6f2;
}

/* ---------------- 档位 ---------------- */
.presets {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.preset {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 4rpx 12rpx;
  margin: 0 4rpx;
  border-radius: 18rpx;
  background: #f7f9fa;
  border: 1rpx solid #eef1f4;
  transition: all 0.15s ease;
}

.preset:active {
  transform: scale(0.97);
}

.preset.active {
  background: linear-gradient(180deg, #e9f8f4 0%, #dff3ee 100%);
  border-color: rgba(15, 156, 140, 0.4);
  box-shadow: 0 6rpx 16rpx rgba(15, 156, 140, 0.14);
}

.preset-lv {
  font-size: 26rpx;
  font-weight: 700;
  color: #7a8fa1;
}

.preset.active .preset-lv {
  color: #0a7e72;
}

.preset-name {
  margin-top: 4rpx;
  font-size: 17rpx;
  line-height: 1.25;
  text-align: center;
  color: #9aa6b2;
}

.preset.active .preset-name {
  color: #0f9c8c;
  font-weight: 600;
}

/* ---------------- 五档对比表（只读） ---------------- */
.ptable {
  margin: 4rpx 0 12rpx;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid #f0f2f5;
}

.ptable-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 12rpx 10rpx;
  background: #fff;
  border-top: 1rpx solid #f5f7f9;
}

.ptable-row.head {
  border-top: none;
  background: #f7f9fa;
}

.ptable-row.active {
  background: #eaf8f4;
}

.pc-lv {
  width: 40rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #7a8fa1;
}

.ptable-row.active .pc-lv {
  color: #0a7e72;
}

.pc-name {
  flex: 1.6;
  padding-left: 8rpx;
  font-size: 19rpx;
  color: #55636e;
}

.ptable-row.active .pc-name {
  color: #0a7e72;
  font-weight: 600;
}

.pc {
  flex: 1;
  text-align: center;
  font-size: 19rpx;
  color: #55636e;
}

.ptable-row.head .pc,
.ptable-row.head .pc-name {
  color: #9aa6b2;
  font-size: 18rpx;
  font-weight: 400;
}

/* ---------------- 参数项 ---------------- */
.item {
  padding: 18rpx 0 14rpx;
  border-top: 1rpx solid #f4f6f8;
}

.item:first-of-type {
  border-top: none;
}

.item-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.item-label {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #2c3e4d;
}

.item-value {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f9c8c;
}

.item-slider {
  margin: 10rpx 0 0;
}

.item-switch {
  display: flex;
  justify-content: flex-end;
  padding-top: 6rpx;
}

.item-tip {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.65;
  color: #a3aab2;
}

/* ---------------- 键值行 ---------------- */
.kv {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-top: 8rpx;
  border-radius: 18rpx;
  background: #f7f9fa;
  border: 1rpx solid #eef1f4;
}

.kv-key {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7a8fa1;
}

.kv-val {
  flex: 1;
  margin-left: 20rpx;
  text-align: right;
  font-size: 22rpx;
  color: #2c3e4d;
  word-break: break-all;
}

/* ---------------- 按钮 ---------------- */
.btn-row {
  display: flex;
  flex-direction: row;
  margin-top: 18rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 600;
  transition: all 0.12s ease;
}

.btn:active {
  transform: scale(0.98);
}

.btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #25b7a3 0%, #0a8b7e 100%);
  box-shadow: 0 10rpx 24rpx rgba(15, 156, 140, 0.24);
}

.btn.ghost {
  color: #2c3e4d;
  background: #fff;
  border: 1rpx solid #e9edf1;
}

/* ---------------- 页脚 ---------------- */
.foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx 40rpx;
}

.foot-line {
  font-size: 20rpx;
  line-height: 1.8;
  color: #b0b6bd;
  text-align: center;
}
