<!--race.wxml —— 体感赛车（原生横屏：page.json 的 pageOrientation: landscape）-->
<view class="page">
  <canvas
    type="2d"
    id="raceCanvas"
    class="race-canvas"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchCancel"
  ></canvas>

  <!-- 返回：横屏左上角 -->
  <view class="back-btn" catchtap="onBack">
    <image class="back-ico" src="/assets/icons/chevron-right-light.png" mode="aspectFit" />
  </view>

  <!--
    训练记录 / 训练设置入口：只在菜单与结算页出现（对局中完全隐藏，不会误触）。
    位置落在引擎设计坐标 1334×750 的左下角空白区（x<357 且 y>600 处没有绘制内容），
    刻意避开右上角的治疗师面板热区与底部居中的提示文案。
  -->
  <view class="side-nav" wx:if="{{showNav}}">
    <view class="side-btn" catchtap="onGoRecords">
      <text class="side-label">记录</text>
    </view>
    <view class="side-btn" catchtap="onGoSettings">
      <text class="side-label">设置</text>
    </view>
  </view>

  <!-- 首次进入提示 -->
  <view class="race-hint" wx:if="{{showHint}}">
    {{hintText}}
  </view>
</view>
