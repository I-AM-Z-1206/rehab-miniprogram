<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap {{selected === index ? 'on' : ''}}">
      <image class="tab-icon" src="{{selected === index ? item.iconOn : item.icon}}" mode="aspectFit" />
    </view>
    <view class="tab-text {{selected === index ? 'on' : ''}}">{{item.text}}</view>
  </view>
</view>
