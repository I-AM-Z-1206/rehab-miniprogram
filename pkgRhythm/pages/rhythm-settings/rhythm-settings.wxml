<!--rhythm-settings.wxml —— 节奏训练：治疗师训练参数-->
<navigation-bar title="节奏训练 · 训练设置" back="{{true}}" color="black" background="#FFFFFF"></navigation-bar>

<scroll-view class="body" scroll-y>
  <!-- 摘要 -->
  <view class="hero">
    <view class="hero-left">
      <text class="hero-kicker">当前难度</text>
      <text class="hero-title">{{difficultyLabel}}</text>
      <text class="hero-desc">参数改动立即生效并自动保存 · {{notePreview}}</text>
    </view>
    <view class="hero-badge">第 {{difficulty}} 档</view>
  </view>

  <!-- 校验提示 -->
  <view class="alert error" wx:if="{{errors.length}}">
    <image class="alert-ico" src="/assets/icons/info-teal.png" mode="aspectFit" />
    <view class="alert-main">
      <text class="alert-title">参数不合法，无法开始训练</text>
      <text class="alert-line" wx:for="{{errors}}" wx:key="*this">· {{item}}</text>
    </view>
  </view>
  <view class="alert warn" wx:if="{{warnings.length}}">
    <text class="alert-title">提醒</text>
    <text class="alert-line" wx:for="{{warnings}}" wx:key="*this">· {{item}}</text>
  </view>

  <!-- 难度 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">难度档位</text>
      <text class="card-sub">套用推荐值</text>
    </view>
    <view class="presets">
      <view
        wx:for="{{presets}}"
        wx:key="lv"
        class="preset {{item.active ? 'active' : ''}}"
        data-lv="{{item.lv}}"
        bindtap="onDifficultyTap"
      >
        <text class="preset-lv">{{item.lv}}</text>
        <text class="preset-name">{{item.label}}</text>
      </view>
    </view>
    <text class="card-tip">档位只影响游戏参数（间隔 / 窗口 / 飞行时间 / 时长），不改变计分公式。</text>

    <!-- 五档对比（只读） -->
    <view class="ptable">
      <view class="ptable-row head">
        <text class="pc-lv">档</text>
        <text class="pc">保持</text>
        <text class="pc">喘息</text>
        <text class="pc">飞行</text>
        <text class="pc">时长</text>
      </view>
      <view class="ptable-row {{item.active ? 'active' : ''}}" wx:for="{{presetRows}}" wx:key="lv">
        <text class="pc-lv">{{item.lv}}</text>
        <text class="pc">{{item.step}}</text>
        <text class="pc">{{item.window}}</text>
        <text class="pc">{{item.fly}}</text>
        <text class="pc">{{item.duration}}</text>
      </view>
    </view>
  </view>

  <!-- 曲目 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">音色</text>
      <text class="card-sub">音符间隔按毫秒，与 BPM 无关</text>
    </view>
    <view
      wx:for="{{songs}}"
      wx:key="songId"
      class="song {{item.active ? 'active' : ''}}"
      data-song="{{item.songId}}"
      bindtap="onSongTap"
    >
      <view class="song-main">
        <text class="song-name">{{item.name}}</text>
        <text class="song-desc">{{item.desc}}</text>
      </view>
      <text class="song-dot" wx:if="{{item.active}}">已选</text>
    </view>
    <text class="card-tip">
      曲目由 tools/gen_rhythm_audio.py 合成，循环长度 = 整数小节，BPM 为精确已知值。
      音乐只作背景：音符节奏由「音符间隔（毫秒）」决定，换曲子不会改变训练强度；
      只有打开「吸附到音乐拍点」后 BPM 才会影响谱面。
    </text>
  </view>

  <!-- 参数分组 -->
  <!-- 治疗师调整区：患者从游戏页点「设置」就能走到这里，
       看到「容差 / 稳时 / 判定半径」不知道该不该动。先一句话说清楚。 -->
  <view class="pro-hint">
    <text class="pro-hint-title">下面这些是治疗师调的参数</text>
    <text class="pro-hint-body">不用改。想调难度，用上面的档位就够了；确定要微调，再往下看。</text>
  </view>

  <view class="card" wx:for="{{groups}}" wx:key="name" wx:for-item="group">
    <view class="card-head">
      <text class="card-title">{{group.name}}</text>
    </view>

    <view class="item" wx:for="{{group.items}}" wx:key="key" wx:for-item="it">
      <view class="item-head">
        <text class="item-label">{{it.label}}</text>
        <text class="item-value">{{it.display}}</text>
      </view>

      <slider
        wx:if="{{it.type === 'num'}}"
        class="item-slider"
        min="{{it.min}}"
        max="{{it.max}}"
        step="{{it.step}}"
        value="{{it.value}}"
        activeColor="#0f9c8c"
        backgroundColor="#e8edf1"
        block-size="22"
        data-key="{{it.key}}"
        bindchanging="onSlide"
        bindchange="onSlideChange"
      />

      <view class="item-switch" wx:elif="{{it.type === 'bool'}}">
        <switch checked="{{it.value}}" color="#0f9c8c" data-key="{{it.key}}" bindchange="onToggle" />
      </view>

      <view class="seg" wx:else>
        <view
          wx:for="{{it.options}}"
          wx:key="value"
          wx:for-item="op"
          class="seg-item {{op.active ? 'active' : ''}}"
          data-key="{{it.key}}"
          data-value="{{op.value}}"
          bindtap="onOptionTap"
        >{{op.label}}</view>
      </view>

      <text class="item-tip" wx:if="{{it.tip}}">{{it.tip}}</text>
    </view>
  </view>

  <!-- 音画同步说明 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">音画同步</text>
      <text class="tag {{syncOffsetMs === 0 ? '' : 'ok'}}">当前 {{syncOffsetMs}} ms</text>
    </view>
    <text class="card-tip">
      门控模式下音符会停在判定线上等，不存在「听到」比「看到」晚的问题 ——
      这个补偿已经不再参与判定，调它不会有任何效果。
    </text>
    <text class="card-tip">
      字段保留是为了历史记录还能解释自己（旧记录里它确实影响过判定）。
    </text>
  </view>

  <!-- 这里原来有一块「训练数据上报 / 接口地址 / 访问令牌」表单。
       上报早已改成登录后静默上传（utils/api.js 统一管地址与 token），
       setUploadConfig 是空实现 —— 患者填了也不会生效，文案还写着
       「未配置时记录只保存在本机」，与真实行为相反。整块删除。 -->

  <!-- 操作 -->
  <view class="btn-row wide">
    <view class="btn ghost" bindtap="onCheck">检查参数</view>
    <view class="btn ghost" bindtap="onReset">恢复默认</view>
  </view>

  <view class="foot">
    <text class="foot-line">所有默认值与档位参数均为待真机实测的游戏参数，</text>
    <text class="foot-line">不代表医疗安全区间，也不构成康复疗效结论。</text>
  </view>
</scroll-view>
