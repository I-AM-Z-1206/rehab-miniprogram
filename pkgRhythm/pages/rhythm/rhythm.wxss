/*rhythm.wxss —— 节奏训练：整页画布，页面本身不排任何 UI，只兜底色（清新明亮）*/

page {
  height: 100vh;
  overflow: hidden;
  background: #eaf7ff;
}

.wrap {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #dff1ff 0%, #eff9ff 42%, #fff8ec 100%);
}

.cv {
  display: block;
  width: 100%;
  height: 100%;
}

/* 初始化兜底（极短时间可见） */
.boot {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #dff1ff 0%, #eff9ff 42%, #fff8ec 100%);
}

.boot-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #ff8fb1;
  box-shadow: 0 6rpx 18rpx rgba(255, 143, 177, 0.5);
}

.boot-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(63, 74, 90, 0.65);
}
