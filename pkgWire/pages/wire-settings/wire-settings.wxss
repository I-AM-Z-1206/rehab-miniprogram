/*wire-settings.wxss —— 走钢丝训练设置：与项目统一卡片规范（28rpx 圆角 / 1rpx 边框 / 柔和阴影）*/

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6fa;
}

.body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 60rpx;
}

/* ---------------- 摘要 ---------------- */
.hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #e8f6f3 0%, #eaf2fb 100%);
  border: 1rpx solid rgba(15, 156, 140, 0.10);
  box-shadow: 0 8rpx 26rpx rgba(15, 40, 70, 0.05);
}

.hero-left {
  display: flex;
  flex-direction: column;
}

.hero-kicker {
  font-size: 22rpx;
  color: #7a8fa1;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #13293a;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7a8fa1;
}

.hero-badge {
  padding: 10rpx 22rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0a7e72;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(15, 156, 140, 0.18);
}

/* ---------------- 提示 ---------------- */
.alert {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid transparent;
}

.alert.error {
  background: #fdf0ee;
  border-color: rgba(223, 85, 64, 0.22);
}

.alert.warn {
  flex-direction: column;
  background: #fdf6ea;
  border-color: rgba(227, 154, 50, 0.24);
}

.alert-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  margin-top: 2rpx;
  opacity: 0.5;
}

.alert-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.alert-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #b8492f;
}

.alert.warn .alert-title {
  color: #9a6414;
}

.alert-line {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #8a5b52;
}

.alert.warn .alert-line {
  color: #8a6b36;
}

/* ---------------- 卡片 ---------------- */
.card {
  padding: 26rpx 26rpx 18rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid #f0f2f5;
  box-shadow: 0 8rpx 28rpx rgba(15, 40, 70, 0.05);
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #13293a;
}

.card-sub {
  font-size: 21rpx;
  color: #9aa6b2;
}

.card-tip {
  display: block;
  margin: 6rpx 0 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #9aa0a6;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  color: #8b8f9a;
  background: #f2f4f6;
}

.tag.ok {
  color: #0a7e72;
  background: #e6f6f2;
}

/* ---------------- 难度 ---------------- */
.presets {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.preset {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 14rpx;
  margin: 0 6rpx;
  border-radius: 20rpx;
  background: #f7f9fa;
  border: 1rpx solid #eef1f4;
  transition: all 0.15s ease;
}

.preset:active {
  transform: scale(0.97);
}

.preset.active {
  background: linear-gradient(180deg, #e9f8f4 0%, #dff3ee 100%);
  border-color: rgba(15, 156, 140, 0.4);
  box-shadow: 0 6rpx 16rpx rgba(15, 156, 140, 0.14);
}

.preset-lv {
  font-size: 30rpx;
  font-weight: 700;
  color: #7a8fa1;
}

.preset.active .preset-lv {
  color: #0a7e72;
}

.preset-name {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #9aa6b2;
}

.preset.active .preset-name {
  color: #0f9c8c;
  font-weight: 600;
}

/* ---------------- 参数项 ---------------- */
.item {
  padding: 18rpx 0 14rpx;
  border-top: 1rpx solid #f4f6f8;
}

.item:first-of-type {
  border-top: none;
}

.item-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.item-label {
  font-size: 26rpx;
  color: #2c3e4d;
}

.item-value {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f9c8c;
}

.item-slider {
  margin: 10rpx 0 0;
}

.item-switch {
  display: flex;
  justify-content: flex-end;
  padding-top: 6rpx;
}

.item-tip {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.65;
  color: #a3aab2;
}

.seg {
  display: flex;
  flex-direction: row;
  margin-top: 12rpx;
  padding: 4rpx;
  border-radius: 16rpx;
  background: #f3f6f8;
}

.seg-item {
  flex: 1;
  padding: 14rpx 8rpx;
  text-align: center;
  font-size: 23rpx;
  color: #7a8fa1;
  border-radius: 13rpx;
}

.seg-item.active {
  color: #0a7e72;
  font-weight: 700;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(15, 40, 70, 0.07);
}

/* ---------------- 输入 ---------------- */
.field {
  margin-top: 10rpx;
}

.field-label {
  font-size: 22rpx;
  color: #7a8fa1;
}

.field-input {
  margin-top: 10rpx;
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  color: #13293a;
  border-radius: 18rpx;
  background: #f7f9fa;
  border: 1rpx solid #eef1f4;
}

/* ---------------- 按钮 ---------------- */
.btn-row {
  display: flex;
  flex-direction: row;
  margin-top: 18rpx;
}

.btn-row.wide {
  margin: 6rpx 0 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: 27rpx;
  font-weight: 600;
  transition: all 0.12s ease;
}

.btn:active {
  transform: scale(0.98);
}

.btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #25b7a3 0%, #0a8b7e 100%);
  box-shadow: 0 10rpx 24rpx rgba(15, 156, 140, 0.24);
}

.btn.ghost {
  margin: 0 6rpx;
  color: #2c3e4d;
  background: #fff;
  border: 1rpx solid #e9edf1;
}

/* ---------------- 页脚 ---------------- */
.foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx 40rpx;
}

.foot-line {
  font-size: 20rpx;
  line-height: 1.8;
  color: #b0b6bd;
  text-align: center;
}
