/*wire.wxss —— 走钢丝：整页画布，页面本身不排任何 UI */

page {
  height: 100vh;
  overflow: hidden;
  background: #0b2233;
}

.wrap {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #7bc6ea 0%, #bfe3f3 55%, #cfe1dd 100%);
}

.cv {
  display: block;
  width: 100%;
  height: 100%;
}

/* 初始化兜底（极短时间可见） */
.boot {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #7bc6ea 0%, #bfe3f3 55%, #cfe1dd 100%);
}

.boot-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #0f9c8c;
  opacity: 0.75;
}

.boot-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(19, 41, 58, 0.7);
}
