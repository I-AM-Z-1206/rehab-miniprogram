/*shoot.wxss —— 射击训练：整页画布，页面本身不排任何 UI（治疗师参数在独立页面）*/

page {
  height: 100vh;
  overflow: hidden;
  background: #070d1c;
}

.wrap {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #070d1c;
}

.cv {
  display: block;
  width: 100%;
  height: 100%;
}

/* 初始化兜底（极短时间可见） */
.boot {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #070d1c;
}

.boot-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #0f9c8c;
  opacity: 0.8;
}

.boot-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: rgba(206, 226, 244, 0.7);
}
