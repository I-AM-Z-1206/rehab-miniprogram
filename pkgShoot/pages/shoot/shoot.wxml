<!--shoot.wxml —— 射击训练：整屏 Canvas 渲染（开始页 / 暂停 / 结算 / 按钮条都在画布里）-->
<view class="wrap">
  <canvas
    type="2d"
    id="gameCanvas"
    class="cv"
    disable-scroll="true"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchCancel"
  ></canvas>

  <!-- 首帧兜底：画布初始化完成前显示，避免白屏 -->
  <view class="boot" wx:if="{{!canvasReady}}">
    <view class="boot-dot"></view>
    <text class="boot-text">正在准备场景…</text>
  </view>
</view>
