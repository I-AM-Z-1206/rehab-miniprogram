<!--shoot-records.wxml —— 射击训练记录-->
<navigation-bar title="射击 · 训练记录" back="{{true}}" color="black" background="#FFFFFF"></navigation-bar>

<scroll-view class="body" scroll-y>
  <!-- 本游戏的稳定率：就地能看到变化，不用跳到「我的进步」。
       指标不是分数 —— 分数受难度影响，升档就掉，会让人误以为退步。 -->
  <view class="mine">
    <view class="mine-left">
      <text class="mine-label">本游戏稳定率</text>
      <text class="mine-sub" wx:if="{{mine.has}}">最近 5 次 · 共 {{mine.count}} 次</text>
      <text class="mine-sub" wx:else>练几次后开始统计</text>
    </view>
    <view class="mine-right">
      <text class="mine-val">{{mine.value}}</text>
      <text class="mine-delta {{mine.tone}}" wx:if="{{mine.delta}}">{{mine.delta}}</text>
    </view>
  </view>

  <!-- 概览 -->
  <view class="summary">
    <view class="sum-cell">
      <text class="sum-num">{{stats.total}}</text>
      <text class="sum-label">总记录</text>
    </view>
    <view class="sum-line"></view>
    <view class="sum-cell">
      <text class="sum-num ok">{{stats.uploaded}}</text>
      <text class="sum-label">已上报</text>
    </view>
    <view class="sum-line"></view>
    <view class="sum-cell">
      <text class="sum-num warn">{{stats.pending}}</text>
      <text class="sum-label">待上报</text>
    </view>
  </view>

  <!-- 上报状态 -->
  <view class="banner {{uploadReady ? 'ok' : ''}}">
    <text class="banner-title">{{uploadReady ? '上报接口已配置' : '上报接口未配置'}}</text>
    <text class="banner-desc">{{uploadReady ? '记录可逐条或批量发送到训练平台' : '记录只保存在本机，登录账号并联网后自动上报'}}</text>
  </view>

  <view class="actions" wx:if="{{list.length}}">
    <view class="act" bindtap="onUploadAll">批量上报（{{pendingCount}}）</view>
  </view>

  <!-- 空态 -->
  <view class="empty" wx:if="{{!list.length}}">
    <text class="empty-title">还没有训练记录</text>
    <text class="empty-desc">完成一局「射击」后，成绩会自动保存在这里</text>
  </view>

  <!-- 列表 -->
  <view class="card" wx:for="{{list}}" wx:key="recordId">
    <view class="row" data-id="{{item.recordId}}" bindtap="onToggle">
      <view class="row-main">
        <view class="row-head">
          <text class="row-score">{{item.score}} 分</text>
          <text class="row-diff">第 {{item.difficulty}} 档</text>
          <text class="row-sim" wx:if="{{item.isSim}}">模拟</text>
          <text class="row-abort" wx:if="{{item.aborted}}">{{item.reason}}</text>
        </view>
        <text class="row-time">{{item.time}} · {{item.duration}}</text>
      </view>
      <view class="row-right">
        <text class="state {{item.state}}">{{item.stateText}}</text>
        <text class="chev">{{expanded === item.recordId ? '收起' : '详情'}}</text>
      </view>
    </view>

    <view class="row-kpi">
      <view class="kpi">
        <text class="kpi-num">{{item.zoneRate}}%</text>
        <text class="kpi-label">保持区</text>
      </view>
      <view class="kpi">
        <text class="kpi-num">{{item.accuracy}}%</text>
        <text class="kpi-label">命中率</text>
      </view>
      <view class="kpi">
        <text class="kpi-num">x{{item.combo}}</text>
        <text class="kpi-label">连击</text>
      </view>
      <view class="kpi">
        <text class="kpi-num">{{item.hits}}</text>
        <text class="kpi-label">命中</text>
      </view>
    </view>

    <!-- 展开详情 -->
    <view class="detail" wx:if="{{expanded === item.recordId}}">
      <view class="d-row">
        <text class="d-key">保持区占比</text>
        <text class="d-val">{{item.zoneRate}}% · 共 {{item.inZoneSec}} 秒</text>
      </view>
      <view class="d-row">
        <text class="d-key">命中 / 开火</text>
        <text class="d-val">{{item.hits}} / {{item.shots}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">最高连击</text>
        <text class="d-val">x{{item.combo}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">训练时长</text>
        <text class="d-val">{{item.duration}} / 计划 {{item.planned}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">完成状态</text>
        <text class="d-val">{{item.completed ? '完成' : item.reason}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">开火频率 / 命中范围</text>
        <text class="d-val">{{item.fireRate}} · {{item.hitRange}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">保持区宽度</text>
        <text class="d-val">{{item.keepRange}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">连击判定窗口</text>
        <text class="d-val">{{item.comboWindow}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">传感器中断</text>
        <text class="d-val">{{item.interrupted}}</text>
      </view>
      <view class="d-row">
        <text class="d-key">数据来源</text>
        <text class="d-val">{{item.source}}</text>
      </view>

      <text class="d-note">保持区占比是身体在判定范围内的时长比例；成绩仅用于训练对比。</text>

      <view class="d-actions">
        <view class="d-btn" wx:if="{{item.canUpload && item.state !== 'uploaded'}}" data-id="{{item.recordId}}" bindtap="onUpload">上报</view>
        <view class="d-btn danger" data-id="{{item.recordId}}" bindtap="onDelete">删除</view>
      </view>
    </view>
  </view>

  <view class="clear" wx:if="{{list.length}}" bindtap="onClearAll">清空本机记录</view>
  <view class="foot">训练数据属于敏感健康相关信息，仅在你确认后才会发送。</view>
</scroll-view>
